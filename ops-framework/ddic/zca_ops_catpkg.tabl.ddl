@EndUserText.label : 'Ops framework: process catalogue packages'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #C
@AbapCatalog.dataMaintenance : #ALLOWED
define table zca_ops_catpkg {
  key mandt    : abap.clnt not null;
  // Package of the process catalogue: product baseline (S4CORE), industry package (FICA), a customer's layer
  key pkg_id   : abap.char(10) not null;
  // S product baseline, I industry package, C customer layer
  pkg_kind     : abap.char(1);
  // Order of the packages: a higher rank may depend on and switch a lower one, never the reverse; unique
  pkg_rank     : abap.int4;
  // Every catalogue process ID of the package starts with it (e.g. FICA_, XX_)
  id_prefix    : abap.char(10);
  // Area of the package's delivered monitoring rows (ZCA_OPS_PROC / _CHECK / _AGG; a parameter area of ZCA_PARAM)
  mon_area     : zca_param_area_id;
  description  : abap.char(60);
  owner        : abap.char(30);
  // Switch of the whole package (its processes are inactive while it is off, whatever their activation)
  active       : abap_boolean;
  // RAP configuration app: set by the framework, ignored by engines
  last_changed_by       : abp_lastchange_user;
  last_changed_at       : abp_lastchange_tstmpl;
  local_last_changed_at : abp_locinst_lastchange_tstmpl;
}
// Seed rows: config/catalogue/seed of the framework (product packages) and of a consumer (its layer), generated by
// tools/process_catalogue.py. Read whole by ZCL_CA_OPS_CAT_DAO (small customizing tables).
