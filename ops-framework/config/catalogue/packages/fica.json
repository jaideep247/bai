   ],
   "monitors": [
    {
     "check": "FICA_PAYRUN_NOPAY",
     "description": "Payments of past runs without a payment document",
     "bukrs_aware": true,
     "schedule_group": "DAILY",
     "aggregates": [
      {
       "id": "R1",
       "table": "DPAYH",
       "description": "Payments of past runs without a payment document",
       "func": "COUNT",
       "date_field": "LAUFD",
       "min_age_days": 1,
       "bukrs_field": "BUKRS",
       "status_field": "DOC1R",
       "status_op": "EQ",
       "status_value": "",
       "amber": 1,
       "red": "‹red count›",
       "check_code": "PAYRUN_NO_DOCUMENT",
       "verify": "V129"
      }
     ]
    }
   ]
  },
