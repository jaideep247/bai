     "role": "C",
     "description": "Payment methods (collection or disbursement)",
     "link_object": "FICA_PAY_METHOD_CFG"
    }
   ],
   "depends_on": [
    {
     "id": "FICA_GL_TRANSFER",
     "kind": "S",
     "description": "Payment documents reach the G/L with their keys"
