{
 "_comment": "Process catalogue, industry package FSCD: SAP standard processes of the insurance extension of contract accounts (SAP FS-CD) on top of FICA. Definitions and monitoring templates only; the activation is the customer's (docs/PROCESS_CATALOGUE.md). The FS-CD object names are VERIFY items (V127 / V128 / V129); every monitoring row is delivered inactive.",
 "package": {
  "id": "FSCD",
  "kind": "I",
  "rank": 30,
  "prefix": "FSCD_",
  "mon_area": "CA_FSCD",
  "description": "Industry package: SAP FS-CD standard processes",
  "owner": "OPS FRAMEWORK",
  "active": true,
  "auth_role": "‹PFCG role of the area›"
 },
 "processes": [
  {
   "id": "FSCD_PAYPLAN",
   "name": "Payment plans and debit entry (insurance)",
   "component": "FS-CD",
   "card": "INSURANCE",
   "owner_role": "Premium accounting lead",
   "schedule": "Daily debit entry run (mass activity)",
   "default_active": false,
   "seq": 10,
   "steps": [
    {
     "kind": "T",
     "name": "‹payment plan of the insurance object›",
     "description": "Maintain the payment plan of a policy",
     "verify": "V127"
    },
    {
     "kind": "M",
     "name": "‹debit entry mass activity type›",
     "description": "Debit entry: payment plan items to receivables",
     "verify": "V127"
    }
   ],
   "tables": [
    {
     "name": "‹payment plan items›",
     "role": "I",
     "description": "Payment plan items of the insurance objects",
     "verify": "V128"
    },
    {
     "name": "DFKKOP",
     "role": "I",
     "description": "Receivables created by the debit entry",
     "link_object": "FICA_OPEN_ITEM"
    }
   ],
   "monitors": [
    {
     "check": "FSCD_PP_NOT_DEBITED",
     "description": "Payment plan items due but not debited",
     "bukrs_aware": false,
     "schedule_group": "DAILY",
     "aggregates": [
      {
       "id": "R1",
       "table": "‹payment plan items›",
       "description": "Due payment plan items not debited",
       "func": "COUNT",
       "date_field": "‹due date field›",
       "min_age_days": 1,
       "status_field": "‹debit entry status›",
       "status_op": "NE",
       "status_value": "‹debited value›",
       "amber": 1,
       "red": "‹red count›",
       "check_code": "PAYPLAN_NOT_DEBITED",
       "verify": "V128"
      }
     ]
    }
   ]
  },
  {
   "id": "FSCD_PREMIUM",
   "name": "Premium collection",
   "component": "FS-CD",
   "card": "INSURANCE",
   "owner_role": "Premium collections lead",
   "schedule": "Daily collection runs",
   "default_active": false,
   "seq": 20,
   "steps": [
    {
     "kind": "T",
     "name": "FPY1",
     "description": "Payment run (collection of premiums)"
    },
    {
     "kind": "T",
     "name": "FP05",
     "description": "Incoming premium payments (payment lots)"
    }
   ],
   "tables": [
    {
     "name": "DFKKOP",
     "role": "I",
     "description": "Premium receivables",
     "link_object": "FICA_OPEN_ITEM"
    },
    {
     "name": "DPAYH",
     "role": "H",
     "description": "Collections of the payment run",
     "link_object": "FICA_PAYMENT_RUN"
    }
   ],
   "depends_on": [
    {
     "id": "FSCD_PAYPLAN",
     "kind": "H",
     "description": "Receivables come from the debit entry"
    },
    {
     "id": "FICA_PAYRUN",
     "kind": "S",
     "description": "Collection by the payment run"
    }
   ],
   "monitors": [
    {
     "check": "FSCD_PREM_OVERDUE",
     "description": "Premium receivables overdue beyond the tolerance",
     "bukrs_aware": true,
     "schedule_group": "DAILY",
     "aggregates": [
      {
       "id": "R1",
       "table": "DFKKOP",
       "description": "Overdue premium receivables",
       "func": "COUNT",
       "date_field": "‹net due date field›",
       "min_age_days": "‹tolerance days›",
       "bukrs_field": "BUKRS",
       "status_field": "‹clearing status field›",
       "status_op": "NE",
       "status_value": "‹cleared value›",
       "amber": "‹amber count›",
       "red": "‹red count›",
       "check_code": "PREMIUM_OVERDUE",
       "verify": "V128"
      }
     ]
    }
   ]
  },
  {
   "id": "FSCD_BROKER",
