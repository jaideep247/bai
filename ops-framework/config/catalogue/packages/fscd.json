       "func": "AGE",
       "date_field": "‹report date field›",
       "min_age_days": 1,
       "status_field": "‹report status field›",
       "status_op": "NE",
       "status_value": "‹posted value›",
       "amber": 2,
       "red": 5,
       "check_code": "BROKER_REPORT_OPEN",
       "verify": "V128"
      }
     ]
    }
   ]
  },
  {
