   "component": "FS-CD",
   "card": "INSURANCE",
   "owner_role": "Broker accounting lead",
   "schedule": "Per broker statement",
   "default_active": false,
   "seq": 30,
   "steps": [
    {
     "kind": "T",
     "name": "‹broker report processing›",
     "description": "Create, check and post a broker report",
     "verify": "V127"
