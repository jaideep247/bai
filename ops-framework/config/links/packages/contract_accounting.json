{
  "_comment": "Link registry, industry package CONTRACT (contract accounting, SAP standard tables of the contract accounts receivable and payable component and its collections / disbursements extension): documents, items, reconciliation keys and their summary records, payment runs, cheques, returns, notification-of-change lots, payment methods. Standard objects and standard links only - a customer's own fields (custom fields on these tables) and tables are its overlay. The join facts are confirmed in a reference landscape (quality C) unless marked P; a field still to be confirmed in SE11 is evidence V (V117) and its link is delivered inactive. Object keys are the fields that identify a row for the walker (business identity, e.g. a document for the items of a document), not necessarily the full DDIC key. docs/LINK_REGISTRY.md.",
  "layer": {"id": "CONTRACT", "kind": "I", "rank": 20, "prefix": "CA_", "description": "Industry package: contract accounting (standard)",
            "owner": "OPS FRAMEWORK", "active": true},
  "objects": [
    {"id": "CA_DOC_HEADER", "source": "DFKKKO", "kind": "T", "keys": ["OPBEL"],
     "description": "Subledger document header",
     "fields": [
       {"name": "OPBEL", "evidence": "C", "description": "Document number (key of the header)"},
       {"name": "FIKEY", "evidence": "C", "description": "Reconciliation key of the document"},
       {"name": "STBEL", "evidence": "V", "verify": "V117", "description": "Reversal document"}
     ]},
    {"id": "CA_OPEN_ITEM", "source": "DFKKOP", "kind": "T", "keys": ["OPBEL"],
     "description": "Subledger items (walked per document)",
     "fields": [
       {"name": "OPBEL", "evidence": "C", "description": "Document number of the item"},
       {"name": "AUGBL", "evidence": "C", "description": "Clearing (payment) document of the item"},
       {"name": "AUGRD", "evidence": "V", "verify": "V117", "description": "Clearing reason"},
       {"name": "BUKRS", "data_element": "BUKRS", "evidence": "V", "verify": "V117", "description": "Company code"},
       {"name": "GPART", "sensitivity": "M", "evidence": "V", "verify": "V117", "description": "Business partner (masked)"}
     ]},
    {"id": "CA_SUMMARY_RECORD", "source": "DFKKSUMC", "kind": "T", "keys": ["FIKEY"],
     "description": "Summary records of a reconciliation key (G/L transfer)",
     "fields": [
       {"name": "FIKEY", "evidence": "C", "description": "Reconciliation key"},
       {"name": "BUKRS", "data_element": "BUKRS", "evidence": "V", "verify": "V117", "description": "Company code"},
       {"name": "HKONT", "evidence": "V", "verify": "V117", "description": "G/L account"},
       {"name": "WAERS", "evidence": "V", "verify": "V117", "description": "Currency"}
     ]},
    {"id": "CA_PAYMENT_RUN", "source": "DPAYH", "kind": "T", "keys": ["LAUFD", "LAUFI", "DOC1R"],
     "description": "Payment of a payment run (payment data header)",
     "fields": [
       {"name": "LAUFD", "evidence": "C", "description": "Run date"},
       {"name": "LAUFI", "evidence": "C", "description": "Run identification"},
       {"name": "DOC1R", "evidence": "C", "description": "Payment document (blank: no payment yet)"},
       {"name": "PYMET", "evidence": "V", "verify": "V117", "description": "Payment method"},
       {"name": "BUKRS", "data_element": "BUKRS", "evidence": "V", "verify": "V117", "description": "Company code"},
       {"name": "HBKID", "evidence": "V", "verify": "V117", "description": "House bank"}
     ]},
    {"id": "CA_CHEQUE", "source": "DFKKCR", "kind": "T", "keys": ["DOC1R", "ZTNUM"],
     "description": "Cheque register",
     "fields": [
       {"name": "DOC1R", "evidence": "C", "description": "Payment document of the cheque"},
       {"name": "ZTNUM", "evidence": "C", "description": "Cheque number"},
       {"name": "HBKID", "evidence": "V", "verify": "V117", "description": "House bank"},
       {"name": "HKTID", "evidence": "V", "verify": "V117", "description": "Account ID of the house bank"}
     ]},
    {"id": "CA_RETURN_ITEM", "source": "DFKKRP", "kind": "T", "keys": ["SELW1"],
     "description": "Returns lot items (walked per payment reference)",
     "fields": [
       {"name": "SELW1", "evidence": "C", "description": "Selection value: the returned payment document"},
       {"name": "RLGRD", "evidence": "C", "description": "Return reason"}
     ]},
    {"id": "CA_NOC_ITEM", "source": "DFKKNRP", "kind": "T", "keys": ["KEYN1", "POSNA"],
     "description": "Notification-of-change lot item",
     "fields": [
       {"name": "KEYN1", "evidence": "C", "description": "Lot"},
       {"name": "POSNA", "evidence": "C", "description": "Item of the lot"},
       {"name": "INFOF", "evidence": "C", "description": "Payment document or payment reference"}
     ]},
    {"id": "CA_PAY_METHOD_CFG", "source": "TFK042Z", "kind": "T", "keys": ["LAND1", "ZLSCH"],
     "description": "Payment method per country (collection or not)",
     "fields": [
       {"name": "LAND1", "evidence": "V", "verify": "V117", "description": "Country"},
       {"name": "ZLSCH", "evidence": "V", "verify": "V117", "description": "Payment method"},
       {"name": "XEINZ", "evidence": "C", "description": "Collection method (blank: disbursement)"}
     ]}
  ],
  "links": [
    {"id": "CA_HDR_TO_ITEMS", "from": "CA_DOC_HEADER", "to": "CA_OPEN_ITEM", "cardinality": "1N", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Document -> its items",
     "conditions": [{"kind": "EQ", "from": "OPBEL", "to": "OPBEL"}]},
    {"id": "CA_ITEM_TO_HDR", "from": "CA_OPEN_ITEM", "to": "CA_DOC_HEADER", "cardinality": "N1", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Item -> its document",
     "conditions": [{"kind": "EQ", "from": "OPBEL", "to": "OPBEL"}]},
    {"id": "CA_ITEM_TO_CLEARING_HDR", "from": "CA_OPEN_ITEM", "to": "CA_DOC_HEADER", "cardinality": "N1", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Item -> header of its clearing (payment) document",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "OPBEL"}]},
    {"id": "CA_CLEARING_TO_ITEMS", "from": "CA_DOC_HEADER", "to": "CA_OPEN_ITEM", "cardinality": "1N", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Clearing (payment) document -> items it cleared",
     "conditions": [{"kind": "EQ", "from": "OPBEL", "to": "AUGBL"}]},
    {"id": "CA_HDR_TO_SUMMARY", "from": "CA_DOC_HEADER", "to": "CA_SUMMARY_RECORD", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Document -> summary records of its reconciliation key",
     "conditions": [{"kind": "EQ", "from": "FIKEY", "to": "FIKEY"}]},
    {"id": "CA_SUMMARY_TO_HDRS", "from": "CA_SUMMARY_RECORD", "to": "CA_DOC_HEADER", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Reconciliation key -> its documents",
     "conditions": [{"kind": "EQ", "from": "FIKEY", "to": "FIKEY"}]},
    {"id": "CA_SUMMARY_TO_JOURNAL", "from": "CA_SUMMARY_RECORD", "to": "S4_JOURNAL_ENTRY", "cardinality": "NM", "quality": "C",
     "active": false, "verify": "V110 V117", "owner": "OPS FRAMEWORK",
     "description": "Reconciliation key -> G/L journal entries of the transfer",
     "conditions": [{"kind": "EQ", "from": "FIKEY", "to": "OriginalReferenceDocument"},
                    {"kind": "CONST", "to": "ReferenceDocumentType", "value": "FKKSU"}]},
    {"id": "CA_JOURNAL_TO_SUMMARY", "from": "S4_JOURNAL_ENTRY", "to": "CA_SUMMARY_RECORD", "cardinality": "NM", "quality": "C",
     "active": false, "verify": "V110 V117", "owner": "OPS FRAMEWORK",
     "description": "G/L journal entry -> summary records of its key",
     "conditions": [{"kind": "EQ", "from": "OriginalReferenceDocument", "to": "FIKEY"}]},
    {"id": "CA_CLEARING_TO_RUN", "from": "CA_OPEN_ITEM", "to": "CA_PAYMENT_RUN", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Item -> payment run rows of its payment document",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "DOC1R"}]},
    {"id": "CA_RUN_TO_CLEARED_ITEMS", "from": "CA_PAYMENT_RUN", "to": "CA_OPEN_ITEM", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Payment of a run -> items its document cleared",
     "conditions": [{"kind": "EQ", "from": "DOC1R", "to": "AUGBL"}]},
    {"id": "CA_PAYMENT_TO_CHEQUE", "from": "CA_OPEN_ITEM", "to": "CA_CHEQUE", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Payment document -> its cheque",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "DOC1R"}]},
    {"id": "CA_CHEQUE_TO_PAYMENT", "from": "CA_CHEQUE", "to": "CA_OPEN_ITEM", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Cheque -> items cleared by its payment document",
     "conditions": [{"kind": "EQ", "from": "DOC1R", "to": "AUGBL"}]},
    {"id": "CA_CHEQUE_TO_STMT_LINE", "from": "CA_CHEQUE", "to": "S4_BANK_STMT_LINE", "cardinality": "NM", "quality": "C",
     "verify": "V117", "owner": "OPS FRAMEWORK",
     "description": "Cheque -> bank lines with its number (cheque method)",
     "conditions": [{"kind": "EQ", "from": "ZTNUM", "to": "CHECT", "transform": "RIGHT", "arg": "13"}]},
    {"id": "CA_STMT_LINE_TO_CHEQUE", "from": "S4_BANK_STMT_LINE", "to": "CA_CHEQUE", "cardinality": "NM", "quality": "P",
     "verify": "V117", "owner": "OPS FRAMEWORK",
     "description": "Bank line -> cheque of that number (cheque method)",
     "conditions": [{"kind": "EQ", "from": "CHECT", "to": "ZTNUM"}]},
    {"id": "CA_PAYMENT_TO_STMT_LINE", "from": "CA_OPEN_ITEM", "to": "S4_BANK_STMT_LINE", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Payment document -> bank lines (transfer methods)",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "CHECT"}]},
    {"id": "CA_STMT_LINE_TO_PAYMENT", "from": "S4_BANK_STMT_LINE", "to": "CA_OPEN_ITEM", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Bank line -> items of the payment it references",
     "conditions": [{"kind": "EQ", "from": "CHECT", "to": "AUGBL"}]},
    {"id": "CA_PAYMENT_TO_RETURN", "from": "CA_OPEN_ITEM", "to": "CA_RETURN_ITEM", "cardinality": "NM", "quality": "C",
     "owner": "OPS FRAMEWORK", "description": "Payment document -> returns lot items",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "SELW1"}]},
    {"id": "CA_PAYMENT_TO_NOC", "from": "CA_OPEN_ITEM", "to": "CA_NOC_ITEM", "cardinality": "NM", "quality": "P",
     "owner": "OPS FRAMEWORK", "description": "Payment document -> notification-of-change items",
     "conditions": [{"kind": "EQ", "from": "AUGBL", "to": "INFOF"}]},
    {"id": "CA_PARTNER_TO_ITEMS", "from": "S4_BUSINESS_PARTNER", "to": "CA_OPEN_ITEM", "cardinality": "1N", "quality": "C",
     "active": false, "verify": "V117", "owner": "OPS FRAMEWORK", "description": "Business partner -> its items",
     "conditions": [{"kind": "EQ", "from": "PARTNER", "to": "GPART"}]},
    {"id": "CA_COUNTRY_METHODS", "from": "S4_COMPANY_CODE", "to": "CA_PAY_METHOD_CFG", "cardinality": "NM", "quality": "C",
     "active": false, "verify": "V110 V117", "owner": "OPS FRAMEWORK",
     "description": "Company code -> payment methods of its country",
     "conditions": [{"kind": "EQ", "from": "Country", "to": "LAND1"}]}
  ]
}
