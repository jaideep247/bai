// Extension: XX extension of ZR_CA_OpsBrkGroup
extend view entity ZR_CA_OpsBrkGroup with
  association [0..1] to ZXX_XC_BRK_GROUP_INTAKE as _ZZXXGrpIntake on  _ZZXXGrpIntake.pay_ref = $projection.Assignment
                                                                  and _ZZXXGrpIntake.bukrs = $projection.CompanyCode
{
  @EndUserText.label: 'Feeder system of the intake'
  case when _ZZXXGrpIntake.Candidates = 1 then _ZZXXGrpIntake.logsys end as ZZXX_GrpIntakeFeeder,
  @EndUserText.label: 'Intake received on'
  case when _ZZXXGrpIntake.Candidates = 1 then _ZZXXGrpIntake.received_on end as ZZXX_GrpIntakeReceived,
  @EndUserText.label: 'Intake match'
  cast( case when _ZZXXGrpIntake.Candidates > 1 then 'AMBIGUOUS' else ' ' end as abap.char( 10 ) ) as ZZXX_GrpIntakeMatch
}
