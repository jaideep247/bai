    INSERT CORRESPONDING #( gc_d011 ) INTO TABLE rt_definitions.
    INSERT CORRESPONDING #( gc_d012 ) INTO TABLE rt_definitions.
    INSERT CORRESPONDING #( gc_d013 ) INTO TABLE rt_definitions.
    INSERT CORRESPONDING #( gc_d014 ) INTO TABLE rt_definitions.
    INSERT CORRESPONDING #( gc_d015 ) INTO TABLE rt_definitions.
    INSERT CORRESPONDING #( gc_d016 ) INTO TABLE rt_definitions.
  ENDMETHOD.



  METHOD constructor.
    mo_dao = NEW #( ).
    LOOP AT areas( ) ASSIGNING FIELD-SYMBOL(<ls_area>).
      mo_dao->add_area( <ls_area> ).
    ENDLOOP.
    mo_dao->add_area( VALUE #( area = gc_test_area-first active = abap_true ) ).
    mo_dao->add_area( VALUE #( area = gc_test_area-second active = abap_true ) ).
    LOOP AT definitions( ) ASSIGNING FIELD-SYMBOL(<ls_definition>).
      mo_dao->add_definition( <ls_definition> ).
    ENDLOOP.
    mo_param = NEW zcl_ca_param( io_dao = mo_dao ).
  ENDMETHOD.


  METHOD set.
    DATA ls_value TYPE zif_ca_param_types=>ty_value_row.

    remove( iv_name ).
    ls_value-area = params( )->area_of( iv_name ).
    ls_value-name = iv_name.
    ls_value-numb = 1.
    ls_value-sign = zif_ca_param_types=>gc_sign-include.
    ls_value-opti = zif_ca_param_types=>gc_option-eq.
    ls_value-low  = iv_value.
    mo_dao->add_value( ls_value ).
    ro_self = me.
  ENDMETHOD.


  METHOD remove.
    mo_dao->remove_values( iv_area = params( )->area_of( iv_name )
                           iv_name = iv_name ).
    " the read logic buffers per area: the next read sees the change
    mo_param->refresh( ).
  ENDMETHOD.


  METHOD dao.
    ro_dao = mo_dao.
  ENDMETHOD.


  METHOD params.
    IF mo_params IS NOT BOUND.
      mo_params = NEW zcl_ca_ops_params( io_param = mo_param ).
    ENDIF.
    ro_params = mo_params.
  ENDMETHOD.

ENDCLASS.
