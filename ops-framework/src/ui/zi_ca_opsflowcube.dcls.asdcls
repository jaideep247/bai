// Artifact: zi_ca_opsflowcube.dcls.asdcls
// Purpose: Read access to the account flow cube (query ZC_CA_OpsFlowQry): authorization object ZCA_OPS with ZCA_PARAR =
//          the area and ACTVT 03, and the same object with BUKRS = the company code of the account column (company-code
//          isolation, docs/auth_zca_ops.md section 3c) - the rule of the break analysis cube.
// Modification log: 2026-11-15 | Initial version (build G: account flow reconciliation).
// VERIFY-ADT: aspect pfcg_auth on a cube view with parameters (7.58) - V147.
@EndUserText.label: 'Account flow cube - read access'
@MappingRole: true
define role ZI_CA_OpsFlowCube {
  grant select on ZI_CA_OpsFlowCube
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( Area, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
}
