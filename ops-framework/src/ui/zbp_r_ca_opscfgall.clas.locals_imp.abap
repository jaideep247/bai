CLASS lhc_alertrule IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCA_OPS for the area of the app: change of a row 02, delete 06 (create 01: root)
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-change ).
    ENDIF.
    IF requested_authorizations-%delete = if_abap_behv=>mk-on.
      result-%delete = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-delete ).
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: delete only where new entries are allowed (DV1); production keeps rows
    IF requested_features-%delete = if_abap_behv=>mk-on.
      result-%delete = COND #( WHEN zcl_ca_ops_cfg_factory=>get_gate( )->delete_allowed( ) = abap_true
                               THEN if_abap_behv=>fc-o-enabled
                               ELSE if_abap_behv=>fc-o-disabled ).
    ENDIF.
  ENDMETHOD.


  METHOD validatefields.
    DATA lt_msg TYPE zif_ca_ops_cfg_types=>tt_field_message.

    READ ENTITIES OF zr_ca_opscfgall IN LOCAL MODE
      ENTITY AlertRule
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_rows).
    CHECK lt_rows IS NOT INITIAL.

    LOOP AT lt_rows INTO DATA(ls_row).
      CLEAR lt_msg.
      INSERT VALUE #( %tky = ls_row-%tky %state_area = gc_area_fields ) INTO TABLE reported-alertrule.
      IF zcl_ca_ops_cfg_checks=>area_valid( iv_area        = ls_row-Area
                                           iv_any_allowed = abap_true ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-area_invalid v1 = ls_row-Area
                        element = lif_c=>gc_el-area ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-MinSeverity )
                                        iv_list  = lif_c=>gc_val-alertrule_minseverity ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinSeverity
                        v2 = lif_c=>gc_el-minseverity v3 = lif_c=>gc_val-alertrule_minseverity
                        element = lif_c=>gc_el-minseverity ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-MinRag )
                                        iv_list  = lif_c=>gc_val-alertrule_minrag ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinRag
                        v2 = lif_c=>gc_el-minrag v3 = lif_c=>gc_val-alertrule_minrag
                        element = lif_c=>gc_el-minrag ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>window_complete( iv_from = ls_row-QuietFrom
                                                iv_to   = ls_row-QuietTo ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-window_incomplete v1 = lif_c=>gc_el-quietfrom v2 = lif_c=>gc_el-quietto
                        element = lif_c=>gc_el-quietto ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_util=>pcre_valid( ls_row-RulePattern ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-pattern_invalid v1 = ls_row-RulePattern
                        element = lif_c=>gc_el-rulepattern ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_util=>pcre_valid( ls_row-CheckPattern ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-pattern_invalid v1 = ls_row-CheckPattern
                        element = lif_c=>gc_el-checkpattern ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_util=>pcre_valid( ls_row-Group1Pattern ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-pattern_invalid v1 = ls_row-Group1Pattern
                        element = lif_c=>gc_el-group1pattern ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_util=>pcre_valid( ls_row-Group2Pattern ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-pattern_invalid v1 = ls_row-Group2Pattern
                        element = lif_c=>gc_el-group2pattern ) INTO TABLE lt_msg.
      ENDIF.
      DATA(lv_dest_invalid) = zcl_ca_ops_cfg_checks=>invalid_destination(
                                iv_class       = zcl_ca_ops_cfg_checks=>channel_class( ls_row-Channel )
                                iv_destination = CONV #( |{ ls_row-Destination },{ ls_row-EscalationDest }| ) ).
      IF lv_dest_invalid IS NOT INITIAL.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-dest_invalid v1 = ls_row-Channel v2 = lv_dest_invalid
                        element = lif_c=>gc_el-destination ) INTO TABLE lt_msg.
      ENDIF.

      LOOP AT lt_msg INTO DATA(ls_msg).
        INSERT VALUE #( %tky = ls_row-%tky ) INTO TABLE failed-alertrule.
        INSERT INITIAL LINE INTO TABLE reported-alertrule ASSIGNING FIELD-SYMBOL(<ls_reported>).
        <ls_reported>-%tky        = ls_row-%tky.
        <ls_reported>-%state_area = gc_area_fields.
        <ls_reported>-%msg        = new_message( id       = zif_ca_ops_types=>gc_message_class
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1
                                                 v2       = ls_msg-v2
                                                 v3       = ls_msg-v3 ).
        <ls_reported>-%path-opscfgall-%is_draft   = ls_row-%is_draft.
        <ls_reported>-%path-opscfgall-SingletonID = 1.
        ASSIGN COMPONENT ls_msg-element OF STRUCTURE <ls_reported>-%element TO FIELD-SYMBOL(<lv_flag>).
        IF sy-subrc = 0.
          <lv_flag> = if_abap_behv=>mk-on.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD validatetransport.
    " DV1: every change (also a deletion) needs an open customizing request on the root
    CHECK keys IS NOT INITIAL.
    READ ENTITIES OF zr_ca_opscfgall IN LOCAL MODE
      ENTITY OpsCfgAll
        FIELDS ( TransportRequestID )
        WITH VALUE #( ( %is_draft = keys[ 1 ]-%is_draft SingletonID = 1 ) )
      RESULT DATA(lt_root).
    DATA(ls_msg) = zcl_ca_ops_cfg_factory=>get_gate( )->check_request(
                     VALUE #( lt_root[ 1 ]-TransportRequestID OPTIONAL ) ).
    LOOP AT keys INTO DATA(ls_key).
      INSERT VALUE #( %tky = ls_key-%tky %state_area = gc_area_transport ) INTO TABLE reported-alertrule.
      IF ls_msg-number IS INITIAL.
        CONTINUE.
      ENDIF.
      INSERT VALUE #( %tky = ls_key-%tky ) INTO TABLE failed-alertrule.
      INSERT VALUE #( %tky        = ls_key-%tky
                      %state_area = gc_area_transport
                      %msg        = new_message( id       = zif_ca_ops_types=>gc_message_class
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1 )
                      %path       = VALUE #( opscfgall-%is_draft   = ls_key-%is_draft
                                             opscfgall-SingletonID = 1 ) )
        INTO TABLE reported-alertrule.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.


