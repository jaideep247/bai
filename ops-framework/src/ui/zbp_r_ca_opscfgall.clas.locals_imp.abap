                                        iv_list  = lif_c=>gc_val-alertrule_minseverity ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinSeverity
                        v2 = lif_c=>gc_el-minseverity v3 = lif_c=>gc_val-alertrule_minseverity
                        element = lif_c=>gc_el-minseverity ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-MinRag )
                                        iv_list  = lif_c=>gc_val-alertrule_minrag ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinRag
                        v2 = lif_c=>gc_el-minrag v3 = lif_c=>gc_val-alertrule_minrag
                        element = lif_c=>gc_el-minrag ) INTO TABLE lt_msg.
      ENDIF.
