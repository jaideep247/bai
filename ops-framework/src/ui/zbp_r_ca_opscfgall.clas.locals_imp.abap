CLASS lsc_zr_ca_opscfgall DEFINITION INHERITING FROM cl_abap_behavior_saver.
  PROTECTED SECTION.
    METHODS save_modified REDEFINITION.
    METHODS cleanup_finalize REDEFINITION.
ENDCLASS.


CLASS lsc_zr_ca_opscfgall IMPLEMENTATION.

  METHOD save_modified.
    " The root is virtual (singleton): nothing to persist. Children are saved by
    " the framework; here they are recorded on the customizing request where the
    " client records changes (DV1). Production: no-op (change log via table logging).
    DATA(lv_request) = VALUE zif_ca_ops_cfg_types=>ty_request( update-opscfgall[ 1 ]-TransportRequestID OPTIONAL ).
    TRY.
        zcl_ca_ops_cfg_factory=>get_gate( )->record(
          iv_request   = lv_request
          it_relations = VALUE #(
            ( entity = lif_c=>gc_ent-alertrule table = lif_c=>gc_tab-alertrule )
            ( entity = lif_c=>gc_ent-alertchannel table = lif_c=>gc_tab-alertchannel )
            ( entity = lif_c=>gc_ent-purgetarget table = lif_c=>gc_tab-purgetarget )
            ( entity = lif_c=>gc_ent-control table = lif_c=>gc_tab-control )
            ( entity = lif_c=>gc_ent-controltext table = lif_c=>gc_tab-controltext )
            ( entity = lif_c=>gc_ent-controlcheck table = lif_c=>gc_tab-controlcheck )
            ( entity = lif_c=>gc_ent-process table = lif_c=>gc_tab-process )
            ( entity = lif_c=>gc_ent-registeredcheck table = lif_c=>gc_tab-registeredcheck )
            ( entity = lif_c=>gc_ent-aggregatecheck table = lif_c=>gc_tab-aggregatecheck )
            ( entity = lif_c=>gc_ent-approvedtable table = lif_c=>gc_tab-approvedtable )
            ( entity = lif_c=>gc_ent-paymdimtext table = lif_c=>gc_tab-paymdimtext )
            ( entity = lif_c=>gc_ent-paymfeeder table = lif_c=>gc_tab-paymfeeder )
            ( entity = lif_c=>gc_ent-schedulerjob table = lif_c=>gc_tab-schedulerjob ) )
          ir_create    = REF #( create )
          ir_update    = REF #( update )
          ir_delete    = REF #( delete ) ).
      CATCH zcx_ca_ops_error INTO DATA(lx_error).
        " A recording client must never keep changes that are not on the request
        RAISE SHORTDUMP lx_error.
    ENDTRY.
  ENDMETHOD.


  METHOD cleanup_finalize.
  ENDMETHOD.

ENDCLASS.
