                                                  iv_field = CONV #( ls_row-BukrsField ) ) = abap_false.
        INSERT VALUE #( number = zif_ca_ops_cfg_types=>gc_msg-field_invalid v1 = ls_row-BukrsField v2 = ls_row-Tabname
