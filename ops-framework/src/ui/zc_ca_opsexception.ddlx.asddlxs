// UI annotations: Owned exceptions (exceptions app)
// 2026-11-07: navigation to FEBAN / FPCPL removed - the suite records exceptions and does not
// reprocess statements or clarify payment lots (read-only scope)
// 2026-11-10: action Classify (reason code of an open exception, e.g. TIMING / INVESTIGATING)
// 2026-11-10: company code of the exception (blank = area-level), column and filter
// 2026-11-11: runbook link and first action of the check (facet Runbook), planned downtime mark, correlation:
//             facet "Correlated exceptions" on a parent (its children - the Resolve action works on several
//             selected rows, each with its own authorisation and ETag) and "Parent exception" on a child
// 2026-11-11: explainable, versioned results - facet "Explanation": check, rule, configuration rule and version
//             of the run that produced the exception, business date and event time
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Exception', typeNamePlural: 'Exceptions',
                  title: { type: #STANDARD, value: 'CheckCode' },
                  description: { type: #STANDARD, value: 'ObjectKey' } }
annotate entity ZC_CA_OpsException with
{
  @UI.facet: [ { id: 'Exception', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Exception', position: 10 },
               { id: 'Runbook', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Runbook',
                 label: 'Runbook', position: 15 },
               { id: 'Explanation', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Explanation',
                 label: 'Explanation', position: 17 },
               { id: 'History', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'History', position: 20,
                 targetElement: '_History' },
               { id: 'Correlated', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Correlated exceptions',
                 position: 30, targetElement: '_CorrChildren' },
               { id: 'Parent', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Parent exception',
                 position: 40, targetElement: '_CorrParent' } ]
  @UI.lineItem: [ { position: 10, importance: #HIGH },
                  { type: #FOR_ACTION, dataAction: 'assignOwner', label: 'Assign' },
                  { type: #FOR_ACTION, dataAction: 'resolveException', label: 'Resolve' },
                  { type: #FOR_ACTION, dataAction: 'requestWaiver', label: 'Request waiver' },
                  { type: #FOR_ACTION, dataAction: 'approveWaiver', label: 'Approve waiver' },
                  { type: #FOR_ACTION, dataAction: 'classifyException', label: 'Classify' } ]
  @UI.identification: [ { position: 10 },
                        { type: #FOR_ACTION, dataAction: 'assignOwner', label: 'Assign' },
                        { type: #FOR_ACTION, dataAction: 'resolveException', label: 'Resolve' },
                        { type: #FOR_ACTION, dataAction: 'requestWaiver', label: 'Request waiver' },
                        { type: #FOR_ACTION, dataAction: 'approveWaiver', label: 'Approve waiver' },
                  { type: #FOR_ACTION, dataAction: 'classifyException', label: 'Classify' } ]
  @UI.selectionField: [ { position: 10 } ]
  Area;
  @UI.lineItem: [ { position: 15, importance: #HIGH } ]
  @UI.identification: [ { position: 15 } ]
  @UI.selectionField: [ { position: 15 } ]
  CompanyCode;
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  CheckCode;
  @UI.lineItem: [ { position: 30, importance: #HIGH } ]
  @UI.identification: [ { position: 30 } ]
  ObjectKey;
  @UI.lineItem: [ { position: 40, importance: #HIGH } ]
  @UI.identification: [ { position: 40 } ]
  @UI.selectionField: [ { position: 30 } ]
  Severity;
  @UI.lineItem: [ { position: 50, importance: #HIGH } ]
  @UI.identification: [ { position: 50 } ]
  @UI.selectionField: [ { position: 40 } ]
  Disposition;
  @UI.lineItem: [ { position: 60, importance: #HIGH } ]
  @UI.identification: [ { position: 60 } ]
  @UI.selectionField: [ { position: 50 } ]
  Owner;
  @UI.lineItem: [ { position: 70, importance: #HIGH } ]
  @UI.identification: [ { position: 70 } ]
  @UI.selectionField: [ { position: 60 } ]
  DueDate;
  @UI.lineItem: [ { position: 80, importance: #MEDIUM } ]
  @UI.identification: [ { position: 80 } ]
  Message;
  @UI.lineItem: [ { position: 90, importance: #MEDIUM } ]
  @UI.identification: [ { position: 90 } ]
  Amount;
  @UI.identification: [ { position: 100 } ]
  Currency;
  @UI.identification: [ { position: 110 } ]
  Reference;
  @UI.identification: [ { position: 120 } ]
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 20 } ]
  RuleId;
  @UI.identification: [ { position: 130 } ]
  Group1;
  @UI.identification: [ { position: 140 } ]
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 10 } ]
  Group2;
  @UI.identification: [ { position: 150 } ]
  Occurrences;
  @UI.identification: [ { position: 160 } ]
  FirstSeenAt;
  @UI.identification: [ { position: 170 } ]
  WaiverReqBy;
  @UI.identification: [ { position: 180 } ]
  WaiverReason;
  @UI.identification: [ { position: 190 } ]
  WaiverUntil;
  @UI.identification: [ { position: 200 } ]
  ResolvedBy;
  @UI.identification: [ { position: 210 } ]
  ResolvedAt;
  @UI.identification: [ { position: 220 } ]
  Resolution;
  // Classification by operations (2026-11-10): e.g. TIMING, INVESTIGATING (parameter EXC_REASON_CODES)
  @UI.lineItem: [ { position: 90, importance: #MEDIUM } ]
  @UI.identification: [ { position: 230 } ]
  @UI.selectionField: [ { position: 70 } ]
  ReasonCode;
  // Operations response features (2026-11-11)
  @UI.fieldGroup: [ { qualifier: 'Runbook', position: 10, type: #WITH_URL, url: 'RunbookUrl' } ]
  @UI.lineItem: [ { position: 95, importance: #LOW, type: #WITH_URL, url: 'RunbookUrl' } ]
  RunbookUrl;
  @UI.fieldGroup: [ { qualifier: 'Runbook', position: 20 } ]
  FirstAction;
  @UI.lineItem: [ { position: 96, importance: #MEDIUM } ]
  @UI.identification: [ { position: 240 } ]
  @UI.selectionField: [ { position: 80 } ]
  IsPlannedDowntime;
  @UI.identification: [ { position: 250 } ]
  DowntimeId;
  @UI.lineItem: [ { position: 97, importance: #MEDIUM } ]
  @UI.identification: [ { position: 260 } ]
  @UI.selectionField: [ { position: 90 } ]
  CorrelationRole;
  @UI.lineItem: [ { position: 98, importance: #MEDIUM } ]
  @UI.identification: [ { position: 270 } ]
  CorrelatedOpen;
  // Explainable, versioned results (2026-11-11): what produced the exception
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 30 } ]
  @UI.lineItem: [ { position: 99, importance: #LOW } ]
  @UI.selectionField: [ { position: 100 } ]
  ConfigRule;
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 40 } ]
  ConfigVersion;
  @UI.lineItem: [ { position: 100, importance: #LOW } ]
  @UI.selectionField: [ { position: 110 } ]
  ConfigVersionShort;
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 50 } ]
  BusinessDate;
  @UI.fieldGroup: [ { qualifier: 'Explanation', position: 60 } ]
  EventAt;
  @UI.hidden: true
  CorrelationId;
  @UI.hidden: true
  RunId;
  @UI.hidden: true
  FindingNo;
}
