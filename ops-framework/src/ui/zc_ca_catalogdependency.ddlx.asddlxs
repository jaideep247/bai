// UI annotations: Processes, checks, alerting, purge targets and controls - Process catalogue dependencies
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Dependency',
                     typeNamePlural: 'Process catalogue dependencies',
                     title: { type: #STANDARD, value: 'ProcessId' } } }
annotate entity ZC_CA_CatalogDependency with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  ProcessId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  PredId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  DepKind;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Description;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
