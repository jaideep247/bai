// UI annotations: Processes, checks, alerting, purge targets and controls - Pilot detection baselines
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Baseline',
                     typeNamePlural: 'Pilot detection baselines',
                     title: { type: #STANDARD, value: 'Area' } } }
annotate entity ZC_CA_PilotBaseline with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Area;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  CheckId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  BaselineMin;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Source;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  Description;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
