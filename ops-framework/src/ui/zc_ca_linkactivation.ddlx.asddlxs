// UI annotations: Processes, checks, alerting, purge targets and controls - Link registry activation overrides
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Activation',
                     typeNamePlural: 'Link registry activation overrides',
                     title: { type: #STANDARD, value: 'TargetKind' } } }
annotate entity ZC_CA_LinkActivation with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  TargetKind;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  TargetId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  LayerId;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Active;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  Reason;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  Owner;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
