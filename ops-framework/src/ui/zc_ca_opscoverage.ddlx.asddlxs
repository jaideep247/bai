// UI annotations: Monitor coverage (service ZUI_CA_OPS_DASH, 2026-11-16, build O)
// Every registered check with its coverage state: a monitor gap (not run in its window, impaired, refused by the
// licence) is red / amber, a check switched off by configuration neutral - a customer sees the gap, never silence.
// Overview page of a consumer that exposes this projection: KPI card "Monitor coverage" per area and licence module
// (data points ChecksExpected, ChecksRan, MonitorGaps; sums over the checks the user may read) and list card "Monitor
// gaps" (selection variant Gaps). VERIFY-ADT: card rendering (OVP V4).
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Monitored check', typeNamePlural: 'Monitor coverage',
                  title: { type: #STANDARD, value: 'CheckName' },
                  description: { type: #STANDARD, value: 'CheckId' } }
@UI.presentationVariant: [ { sortOrder: [ { by: 'Area', direction: #ASC }, { by: 'LicenceModule', direction: #ASC },
                                          { by: 'CoverageCriticality', direction: #ASC } ],
                             visualizations: [ { type: #AS_LINEITEM } ] },
                           { qualifier: 'Gaps',
                             sortOrder: [ { by: 'CoverageCriticality', direction: #ASC } ],
                             maxItems: 10,
                             visualizations: [ { type: #AS_LINEITEM, qualifier: 'Gaps' } ] } ]
@UI.selectionVariant: [ { qualifier: 'Gaps', text: 'Monitor gaps (not run, impaired, refused)', filter: 'GapCount EQ 1' },
                        { qualifier: 'Disabled', text: 'Disabled by configuration', filter: 'DisabledCount EQ 1' } ]
annotate entity ZC_CA_OpsCoverage with
{
  @UI.facet: [ { id: 'Check', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Check', position: 10 },
               { id: 'Coverage', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Coverage',
                 label: 'Coverage and evaluation', position: 20 } ]
  @EndUserText.label: 'Area'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.identification: [ { position: 10 } ]
  Area;
  @EndUserText.label: 'Check ID'
  @UI.lineItem: [ { position: 30, importance: #HIGH } ]
  @UI.identification: [ { position: 30 } ]
  CheckId;
  @EndUserText.label: 'Check'
  @UI.lineItem: [ { position: 35, importance: #HIGH },
                  { qualifier: 'Gaps', position: 10, importance: #HIGH } ]
  @UI.identification: [ { position: 35 } ]
  CheckName;
  @EndUserText.label: 'Business process'
  @UI.lineItem: [ { position: 40, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.identification: [ { position: 40 } ]
  ProcessId;
  @EndUserText.label: 'Catalogue process'
  @UI.identification: [ { position: 45 } ]
  CatalogueProcess;
  @EndUserText.label: 'Check class'
  @UI.identification: [ { position: 50 } ]
  ClassName;
  @EndUserText.label: 'Schedule group'
  @UI.identification: [ { position: 55 } ]
  ScheduleGroup;
  @EndUserText.label: 'Licence module'
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.identification: [ { position: 20 } ]
  LicenceModule;
  @EndUserText.label: 'Coverage'
  @UI.lineItem: [ { position: 50, importance: #HIGH, criticality: 'CoverageCriticality' },
                  { qualifier: 'Gaps', position: 20, importance: #HIGH, criticality: 'CoverageCriticality' } ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 10, criticality: 'CoverageCriticality' } ]
  CoverageState;
  @UI.hidden: true
  CoverageStateText;
  @UI.hidden: true
  CoverageCriticality;
  @EndUserText.label: 'Expected to run (active)'
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 20 } ]
  IsExpected;
  @EndUserText.label: 'Evaluation'
  @UI.lineItem: [ { position: 60, importance: #HIGH, criticality: 'EvaluationCriticality' },
                  { qualifier: 'Gaps', position: 30, importance: #MEDIUM, criticality: 'EvaluationCriticality' } ]
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 30, criticality: 'EvaluationCriticality' } ]
  EvaluationState;
  @UI.hidden: true
  EvaluationStateText;
  @UI.hidden: true
  EvaluationCriticality;
  @EndUserText.label: 'Last evaluated (UTC)'
  @UI.lineItem: [ { position: 70, importance: #MEDIUM },
                  { qualifier: 'Gaps', position: 40, importance: #LOW } ]
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 40 } ]
  EvaluatedAt;
  @EndUserText.label: 'Schedule window (minutes)'
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 50 } ]
  WindowMinutes;
  @EndUserText.label: 'Reason'
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 60 } ]
  EvaluationReason;
  @EndUserText.label: 'Licence at the last run (blank, W, R)'
  @UI.fieldGroup: [ { qualifier: 'Coverage', position: 70 } ]
  LicenceState;
  @EndUserText.label: 'Registered checks'
  CheckCount;
  @EndUserText.label: 'Expected to run'
  @UI.dataPoint: { qualifier: 'ChecksExpected', title: 'Expected to run' }
  ExpectedCount;
  @EndUserText.label: 'Ran in their window'
  @UI.dataPoint: { qualifier: 'ChecksRan', title: 'Ran in their window' }
  RanCount;
  @EndUserText.label: 'Impaired'
  ImpairedCount;
  @EndUserText.label: 'Not run in their window'
  NotRunCount;
  @EndUserText.label: 'Disabled by configuration'
  DisabledCount;
  @EndUserText.label: 'Refused by the licence'
  RefusedCount;
  @EndUserText.label: 'Licence warning'
  WarnedCount;
  @EndUserText.label: 'Monitor gaps'
  @UI.dataPoint: { qualifier: 'MonitorGaps', title: 'Monitor gaps', criticality: 'CoverageCriticality' }
  GapCount;
}
