define service ZUI_CA_OPS_CFG {
  expose ZC_CA_OpsCfgAll as OpsCfgAll;
  expose ZC_CA_AlertRule as AlertRule;
  expose ZC_CA_AlertChannel as AlertChannel;
  expose ZC_CA_PurgeTarget as PurgeTarget;
  expose ZC_CA_Control as Control;
  expose ZC_CA_ControlText as ControlText;
  expose ZC_CA_ControlCheck as ControlCheck;
  expose ZC_CA_Process as Process;
  expose ZC_CA_RegisteredCheck as RegisteredCheck;
  expose ZC_CA_AggregateCheck as AggregateCheck;
  expose ZC_CA_ApprovedTable as ApprovedTable;
  expose ZC_CA_SchedulerJob as SchedulerJob;
}
