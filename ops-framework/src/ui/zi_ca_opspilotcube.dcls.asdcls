// Artifact: zi_ca_opspilotcube.dcls.asdcls
// Purpose: Read access to the pilot metrics cube (query ZC_CA_OpsPilotQry): authorization object ZCA_OPS with ZCA_PARAR = the area and ACTVT 03, and for a
//          row with a company code the same object with BUKRS = its company code (company-code isolation,
//          docs/auth_zca_ops.md section 3c) - the rule of the response-time metrics.
// Modification log: 2026-11-11 | Initial version (build F: pilot pack).
// VERIFY-ADT: aspect pfcg_auth on a cube view (7.58); IS INITIAL in an access condition.
@EndUserText.label: 'Pilot metrics cube - read access'
@MappingRole: true
define role ZI_CA_OpsPilotCube {
  grant select on ZI_CA_OpsPilotCube
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( Area, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
}
