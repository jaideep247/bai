// Artifact: zc_ca_opsexception.dcls.asdcls
// Purpose: Read access to the exceptions app (service ZUI_CA_OPS_EXC): authorization object ZCA_OPS
//          with ZCA_PARAR = the area of the exception and ACTVT 03, as the dashboard DCLs - and, for an
//          exception of a company code, the same object with BUKRS = that company code (company-code
//          isolation, rule of docs/auth_zca_ops.md section 3c): area authorised AND ( company code blank
//          OR ( area, company code ) authorised ). A blank company code is an area-level finding,
//          visible with the area authorisation. The action history is shown with the area and company
//          code of its exception (path _Exception; the history keeps the exception key, no copy of the
//          company code). Actions (assign, resolve, waive, classify) keep their own instance checks in the
//          behaviour pool, with the company code of the exception.
// Modification log: 2026-11-10 | Initial version (read authorisation of the operations apps).
//                   2026-11-10 | Company-code isolation: BUKRS of the exception (ZCA_OPS_FINDING-BUKRS).
// VERIFY-ADT: aspect pfcg_auth on a projection view and on a path to the parent (7.58); an authorisation
//             field that is not mapped (BUKRS in the first condition) is not checked; IS INITIAL in an
//             access condition (fallback: CompanyCode = ' ').
@EndUserText.label: 'Exceptions app - read access'
@MappingRole: true
define role ZC_CA_OpsException {
  grant select on ZC_CA_OpsException
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( Area, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CA_OpsExcHist
    where ( _Exception.Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( _Exception.CompanyCode is initial
         or ( _Exception.Area, _Exception.CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
}
