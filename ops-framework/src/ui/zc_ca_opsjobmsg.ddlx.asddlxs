// UI annotations: SAP job failures board - error / abort lines of the job log (object page table)
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Job log error', typeNamePlural: 'Job log errors',
                  title: { type: #STANDARD, value: 'MessageText' } }
@UI.presentationVariant: [ { sortOrder: [ { by: 'LineNo', direction: #ASC } ] } ]
annotate entity ZC_CA_OpsJobMsg with
{
  @UI.hidden: true
  JobName;
  @UI.hidden: true
  JobCount;
  @EndUserText.label: 'Line'
  @UI.lineItem: [ { position: 10 } ]
  LineNo;
  @EndUserText.label: 'Date'
  @UI.lineItem: [ { position: 20 } ]
  EnteredDate;
  @EndUserText.label: 'Time'
  @UI.lineItem: [ { position: 30 } ]
  EnteredTime;
  @EndUserText.label: 'Message class'
  @UI.lineItem: [ { position: 40 } ]
  MessageClass;
  @EndUserText.label: 'Number'
  @UI.lineItem: [ { position: 50 } ]
  MessageNumber;
  @EndUserText.label: 'Type'
  @UI.lineItem: [ { position: 60 } ]
  MessageType;
  @EndUserText.label: 'Text'
  @UI.lineItem: [ { position: 70 } ]
  MessageText;
  @UI.hidden: true
  Area;
  @UI.hidden: true
  CompanyCode;
}
