projection;
strict ( 2 );
use draft;

define behavior for ZC_CA_OpsCfgAll alias OpsCfgAll
{
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _AlertRule { create; with draft; }
  use association _AlertChannel { create; with draft; }
  use association _PurgeTarget { create; with draft; }
}

define behavior for ZC_CA_AlertRule alias AlertRule
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CA_AlertChannel alias AlertChannel
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CA_PurgeTarget alias PurgeTarget
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}
