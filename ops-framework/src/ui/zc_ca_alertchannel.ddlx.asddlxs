// UI annotations: Alerting and purge targets - Alert channels
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Channel',
                     typeNamePlural: 'Alert channels',
                     title: { type: #STANDARD, value: 'Channel' } } }
annotate entity ZC_CA_AlertChannel with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Channel;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  ClassName;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Destination;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Active;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  TemplateId;

  @UI.hidden: true
  ChangedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
