// Artifact: zc_ca_opscoverage.dcls.asdcls
// Purpose: Read access to the monitor coverage (service ZUI_CA_OPS_DASH): authorization object ZCA_OPS with
//          ZCA_PARAR = the area of the registered check and ACTVT 03. A row is a check of the registry (no company
//          code, no business data).
// Modification log: 2026-11-16 | Initial version (build O: monitor coverage state).
// VERIFY-ADT: aspect pfcg_auth on a projection view (7.58).
@EndUserText.label: 'Monitor coverage - read access'
@MappingRole: true
define role ZC_CA_OpsCoverage {
  grant select on ZC_CA_OpsCoverage
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
}
