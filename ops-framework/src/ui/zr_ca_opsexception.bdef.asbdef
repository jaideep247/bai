managed implementation in class zbp_r_ca_opsexception unique;
strict ( 2 );

// Exceptions app (design 6.1). Operations change an exception only through actions;
// every action writes a history row. No draft: each action is one complete change, so no total etag.
// ETag LastChangedAt (2026-11-10): an action on a version the user did not see (the batch store
// superseded or resolved the exception meanwhile) is refused - the user refreshes, nothing is lost.
define behavior for ZR_CA_OpsException alias Exception
persistent table zca_ops_finding
lock master
authorization master ( instance )
etag master LastChangedAt
{
  internal update;
  field ( readonly ) RunId, FindingNo, Area, CompanyCode, ObjectType, ObjectKey, Group1, Group2, RuleId, CheckCode,
                     Severity, ActionCode, Amount, Currency, Reference, Message, Disposition, Owner, DueDate,
                     ResolvedBy, ResolvedAt, Resolution, FirstSeenAt, Occurrences, WaiverUntil, WaiverReqBy,
                     WaiverReqAt, WaiverReason, CreatedAt, LastChangedAt, ReasonCode;

  // VERIFY-ADT: internal create by association (history written only by the actions)
  association _History { internal create; }

  action ( features : instance ) assignOwner parameter ZA_CA_ExcAssign result [1] $self;
  action ( features : instance ) resolveException parameter ZA_CA_ExcReason result [1] $self;
  action ( features : instance ) requestWaiver parameter ZA_CA_ExcWaiver result [1] $self;
  action ( features : instance ) approveWaiver result [1] $self;
  // 2026-11-10: reason code of an open exception (TIMING, INVESTIGATING, ... - parameter EXC_REASON_CODES)
  action ( features : instance ) classifyException parameter ZA_CA_ExcClassify result [1] $self;

  mapping for zca_ops_finding
  {
    RunId        = run_id;
    FindingNo    = finding_no;
    Area       = area;
    CompanyCode  = bukrs;
    ObjectType   = object_type;
    ObjectKey    = object_key;
    Group1       = group1;
    Group2       = group2;
    RuleId       = rule_id;
    CheckCode    = check_code;
    Severity     = severity;
    ActionCode   = action;
    Amount       = amount;
    Currency     = currency;
    Reference    = reference;
    Message      = message;
    Disposition  = disposition;
    Owner        = owner;
    DueDate      = due_date;
    ResolvedBy   = resolved_by;
    ResolvedAt   = resolved_at;
    Resolution   = resolution;
    FirstSeenAt  = first_seen_at;
    Occurrences  = occurrences;
    WaiverUntil  = waiver_until;
    WaiverReqBy  = waiver_req_by;
    WaiverReqAt  = waiver_req_at;
    WaiverReason = waiver_reason;
    CreatedAt    = created_at;
    LastChangedAt = last_changed_at;
    ReasonCode   = reason_code;
  }
}

define behavior for ZR_CA_OpsExcHist alias History
persistent table zca_ops_exc_hist
lock dependent by _Exception
authorization dependent by _Exception
{
  field ( numbering : managed, readonly ) HistUuid;
  field ( readonly ) RunId, FindingNo, HistAction, FromDisp, ToDisp, Owner, Reason, Reference, CreatedBy, CreatedAt;
  association _Exception;

  mapping for zca_ops_exc_hist
  {
    HistUuid   = hist_uuid;
    RunId      = run_id;
    FindingNo  = finding_no;
    HistAction = action;
    FromDisp   = from_disp;
    ToDisp     = to_disp;
    Owner      = owner;
    Reason     = reason;
    Reference  = reference;
    CreatedBy  = created_by;
    CreatedAt  = created_at;
  }
}
