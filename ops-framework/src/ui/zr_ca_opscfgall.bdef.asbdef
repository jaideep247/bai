managed implementation in class zbp_r_ca_opscfgall unique;
strict ( 2 );
with draft;

// Processes, checks, alerting, purge targets and controls: singleton root (virtual, nothing persisted) - lock, total ETag,
// draft and the customizing request; every customizing table is a child.
define behavior for ZR_CA_OpsCfgAll alias OpsCfgAll
with unmanaged save
draft table zca_d_opscfg
lock master
total etag LastChangedAtMax
authorization master ( global )
##DRAFT_OP_NOT_REQUIRED
{
  update;
  field ( readonly ) SingletonID, LastChangedAtMax;

  association _AlertRule { create ( features : global ); with draft; }
  association _AlertChannel { create ( features : global ); with draft; }
  association _PurgeTarget { create ( features : global ); with draft; }
  association _Control { create ( features : global ); with draft; }
  association _ControlText { create ( features : global ); with draft; }
  association _ControlCheck { create ( features : global ); with draft; }
  association _Process { create ( features : global ); with draft; }
  association _RegisteredCheck { create ( features : global ); with draft; }
  association _AggregateCheck { create ( features : global ); with draft; }
  association _ApprovedTable { create ( features : global ); with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation AlertRule ~ validateFields;
    validation AlertRule ~ validateTransport;
    validation AlertChannel ~ validateFields;
    validation AlertChannel ~ validateTransport;
    validation PurgeTarget ~ validateFields;
    validation PurgeTarget ~ validateTransport;
    validation Control ~ validateFields;
    validation Control ~ validateTransport;
    validation ControlText ~ validateFields;
    validation ControlText ~ validateTransport;
    validation ControlCheck ~ validateFields;
    validation ControlCheck ~ validateTransport;
    validation Process ~ validateFields;
    validation Process ~ validateTransport;
    validation RegisteredCheck ~ validateFields;
    validation RegisteredCheck ~ validateTransport;
    validation AggregateCheck ~ validateFields;
    validation AggregateCheck ~ validateTransport;
    validation ApprovedTable ~ validateFields;
    validation ApprovedTable ~ validateTransport;
  }
}

define behavior for ZR_CA_AlertRule alias AlertRule
persistent table zca_ops_alrule
with additional save
