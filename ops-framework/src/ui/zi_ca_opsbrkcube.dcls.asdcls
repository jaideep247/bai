// Artifact: zi_ca_opsbrkcube.dcls.asdcls
// Purpose: Read access to the break analysis cube (query ZC_CA_OpsBrkQry): authorization object ZCA_OPS with ZCA_PARAR = the area and ACTVT 03, and for a
//          row with a company code the same object with BUKRS = its company code (company-code isolation,
//          docs/auth_zca_ops.md section 3c) - the rule of the area dashboard.
// Modification log: 2026-11-11 | Initial version (build F: clearing-account break analysis).
// VERIFY-ADT: aspect pfcg_auth on a cube view (7.58); IS INITIAL in an access condition.
@EndUserText.label: 'Break analysis cube - read access'
@MappingRole: true
define role ZI_CA_OpsBrkCube {
  grant select on ZI_CA_OpsBrkCube
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( Area, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
}
