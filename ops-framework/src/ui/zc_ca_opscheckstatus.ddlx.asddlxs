// UI annotations: Area dashboard - status per registered check (service ZUI_CA_OPS_DASH)
// Overview page cards of a consumer that exposes this projection (2026-11-10): KPI "Business processes" (data
// points ProcessChecks, ChecksFlagged, ChecksStale, OpenExceptions; sums over the slices the user may read) and
// list "Process checks - attention" (selection variant Attention, presentation variant Attention: worst status
// first, then stale, then most open exceptions). VERIFY-ADT: card rendering (OVP V4).
// 2026-11-11: planned downtime of the area now (column, filter, run group).
// 2026-11-16: evaluation state (build O): column with text and criticality (not evaluated / stale red, partial and
// findings amber - never green when unknown), facet "Evaluation", variant "Not evaluated, stale or partial", data
// point ChecksUnknown for the KPI card.
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Check', typeNamePlural: 'Checks by area',
                  title: { type: #STANDARD, value: 'CheckName' },
                  description: { type: #STANDARD, value: 'CheckId' } }
@UI.presentationVariant: [ { sortOrder: [ { by: 'Area', direction: #ASC }, { by: 'ProcessId', direction: #ASC },
                                          { by: 'CheckId', direction: #ASC } ],
                             visualizations: [ { type: #AS_LINEITEM } ] },
                           { qualifier: 'Attention',
                             sortOrder: [ { by: 'StatusCriticality', direction: #ASC },
                                          { by: 'StaleCriticality', direction: #ASC },
                                          { by: 'OpenExceptions', direction: #DESC } ],
                             maxItems: 10,
                             visualizations: [ { type: #AS_LINEITEM, qualifier: 'Attention' } ] } ]
@UI.selectionVariant: [ { qualifier: 'Attention', text: 'Needs attention (open exceptions or stale)', filter: 'IsAttention EQ X' },
                        { qualifier: 'Stale', text: 'Stale checks (no recent run)', filter: 'IsStale EQ X' },
                        { qualifier: 'Unknown', text: 'Not evaluated, stale or partial', filter: 'IsEvaluationUnknown EQ X' } ]
annotate entity ZC_CA_OpsCheckStatus with
{
  @UI.facet: [ { id: 'Check', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Check', position: 10 },
               { id: 'Run', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Run',
                 label: 'Latest run and freshness', position: 20 },
               { id: 'Evaluation', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Evaluation',
                 label: 'Evaluation: expected, observed, unknown', position: 30 } ]
  @EndUserText.label: 'Area'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.identification: [ { position: 10 } ]
  Area;
  @EndUserText.label: 'Check ID'
  @UI.lineItem: [ { position: 30, importance: #HIGH } ]
  @UI.identification: [ { position: 30 } ]
  CheckId;
  @EndUserText.label: 'Company code (blank = area-level)'
  @UI.lineItem: [ { position: 40, importance: #MEDIUM },
                  { qualifier: 'Attention', position: 30, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 40 } ]
  CompanyCode;
  @EndUserText.label: 'Business process'
  @UI.lineItem: [ { position: 20, importance: #HIGH },
                  { qualifier: 'Attention', position: 10, importance: #HIGH } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.identification: [ { position: 20 } ]
  ProcessId;
  @EndUserText.label: 'Process name'
  @UI.identification: [ { position: 25 } ]
  ProcessName;
  @EndUserText.label: 'Catalogue process'
  @UI.identification: [ { position: 26 } ]
  CatalogueProcess;
  @EndUserText.label: 'Dashboard card'
  @UI.selectionField: [ { position: 25 } ]
  @UI.identification: [ { position: 27 } ]
  DashboardCard;
  @EndUserText.label: 'Check'
  @UI.lineItem: [ { position: 35, importance: #HIGH },
                  { qualifier: 'Attention', position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 35 } ]
  CheckName;
  @EndUserText.label: 'Schedule group'
  @UI.selectionField: [ { position: 30 } ]
  @UI.identification: [ { position: 40 } ]
  ScheduleGroup;
  @EndUserText.label: 'Check class'
  @UI.identification: [ { position: 50 } ]
  ClassName;
  @EndUserText.label: 'Reports per company code'
  @UI.identification: [ { position: 60 } ]
  IsCompanyCodeAware;
  @UI.hidden: true
  LastRunId;
  @EndUserText.label: 'Last run started (UTC)'
  @UI.lineItem: [ { position: 60, importance: #HIGH },
                  { qualifier: 'Attention', position: 70, importance: #LOW } ]
  @UI.fieldGroup: [ { qualifier: 'Run', position: 10 } ]
  LastRunAt;
  @EndUserText.label: 'Last run status (S, W, E, A)'
  @UI.fieldGroup: [ { qualifier: 'Run', position: 20 } ]
  LastRunStatus;
  @EndUserText.label: 'Last run RAG'
  @UI.lineItem: [ { position: 70, importance: #MEDIUM, criticality: 'RunCriticality' } ]
  @UI.fieldGroup: [ { qualifier: 'Run', position: 30, criticality: 'RunCriticality' } ]
  LastRunRag;
  @UI.hidden: true
  RunCriticality;
  @EndUserText.label: 'Open exceptions'
  @UI.lineItem: [ { position: 50, importance: #HIGH, criticality: 'StatusCriticality' },
                  { qualifier: 'Attention', position: 50, importance: #HIGH, criticality: 'StatusCriticality' } ]
  @UI.dataPoint: { qualifier: 'OpenExceptions', title: 'Open exceptions', criticality: 'StatusCriticality' }
  OpenExceptions;
  @EndUserText.label: 'Status (worst open exception)'
  @UI.lineItem: [ { position: 45, importance: #HIGH, criticality: 'StatusCriticality' },
                  { qualifier: 'Attention', position: 40, importance: #HIGH, criticality: 'StatusCriticality' } ]
  @UI.selectionField: [ { position: 50 } ]
  @UI.identification: [ { position: 70, criticality: 'StatusCriticality' } ]
  Status;
  @UI.hidden: true
  StatusCriticality;
  @EndUserText.label: 'Stale after (minutes)'
  @UI.fieldGroup: [ { qualifier: 'Run', position: 50 } ]
  StaleAfterMinutes;
  @EndUserText.label: 'Age of the last run (minutes)'
  @UI.fieldGroup: [ { qualifier: 'Run', position: 40, criticality: 'StaleCriticality' } ]
  AgeMinutes;
  @EndUserText.label: 'Stale (no recent run)'
  @UI.lineItem: [ { position: 80, importance: #HIGH, criticality: 'StaleCriticality' },
                  { qualifier: 'Attention', position: 60, importance: #HIGH, criticality: 'StaleCriticality' } ]
  @UI.selectionField: [ { position: 60 } ]
  @UI.fieldGroup: [ { qualifier: 'Run', position: 60, criticality: 'StaleCriticality' } ]
  IsStale;
  @UI.hidden: true
  StaleCriticality;
  // Planned downtime of the area now (2026-11-11): findings are recorded, alerts held back
  @EndUserText.label: 'Planned downtime (area, now)'
  @UI.lineItem: [ { position: 85, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 70 } ]
  @UI.fieldGroup: [ { qualifier: 'Run', position: 70 } ]
  IsPlannedDowntime;
  @EndUserText.label: 'Active downtime windows'
  @UI.fieldGroup: [ { qualifier: 'Run', position: 80 } ]
  PlannedDowntimeWindows;
  @UI.hidden: true
  SliceCount;
  @EndUserText.label: 'Flagged (check and company code)'
  @UI.dataPoint: { qualifier: 'ChecksFlagged', title: 'Flagged (open exceptions, per company code)' }
  FlaggedCount;
  @EndUserText.label: 'Registered checks'
  @UI.dataPoint: { qualifier: 'ProcessChecks', title: 'Registered checks' }
  CheckCount;
  @EndUserText.label: 'Stale checks'
  @UI.dataPoint: { qualifier: 'ChecksStale', title: 'Stale (no recent run)' }
  StaleCount;
  @EndUserText.label: 'Needs attention'
  @UI.hidden: true
  IsAttention;
  // Evaluation state (2026-11-16, build O): unknown is shown, never green
  @EndUserText.label: 'Evaluation'
  @UI.lineItem: [ { position: 47, importance: #HIGH, criticality: 'EvaluationCriticality' },
                  { qualifier: 'Attention', position: 45, importance: #HIGH, criticality: 'EvaluationCriticality' } ]
  @UI.selectionField: [ { position: 55 } ]
  @UI.identification: [ { position: 75, criticality: 'EvaluationCriticality' } ]
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 10, criticality: 'EvaluationCriticality' } ]
  EvaluationState;
  @UI.hidden: true
  EvaluationStateText;
  @UI.hidden: true
  EvaluationCriticality;
  @EndUserText.label: 'Completeness (C, P, N)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 20 } ]
  EvaluationCompleteness;
  @EndUserText.label: 'Result class'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 30 } ]
  EvaluationResult;
  @EndUserText.label: 'Reason (when not complete)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 40 } ]
  EvaluationReason;
  @EndUserText.label: 'Evaluated at (UTC)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 50 } ]
  EvaluatedAt;
  @EndUserText.label: 'Expected scope: business date'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 60 } ]
  ScopeDate;
  @EndUserText.label: 'Expected scope: period'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 70 } ]
  ScopePeriod;
  @EndUserText.label: 'Expected scope: company codes'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 80 } ]
  ScopeCompanyCodes;
  @EndUserText.label: 'Expected'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 90 } ]
  ExpectedCount;
  @EndUserText.label: 'Observed'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 100 } ]
  ObservedCount;
  @EndUserText.label: 'Source freshness (oldest newest observation, UTC)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 110 } ]
  SourceFreshAt;
  @EndUserText.label: 'Stalest source'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 120 } ]
  FreshSource;
  @EndUserText.label: 'Watermark (UTC)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 130 } ]
  Watermark;
  @EndUserText.label: 'Last valid result at (UTC)'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 140 } ]
  LastValidAt;
  @EndUserText.label: 'Last valid result'
  @UI.fieldGroup: [ { qualifier: 'Evaluation', position: 150 } ]
  LastValidResult;
  @EndUserText.label: 'Evaluation unknown'
  @UI.hidden: true
  IsEvaluationUnknown;
  @EndUserText.label: 'Checks not evaluated, stale or partial'
  @UI.dataPoint: { qualifier: 'ChecksUnknown', title: 'Unknown (not evaluated, stale, partial)' }
  UnknownCount;
  @EndUserText.label: 'Checks not evaluated'
  NotEvaluatedCount;
  @EndUserText.label: 'Checks partly evaluated'
  PartialCount;
}
