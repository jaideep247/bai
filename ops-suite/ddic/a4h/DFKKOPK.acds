@EndUserText.label : 'Positionen zum Kontokorrentbeleg'
@AbapCatalog.enhancement.category : #EXTENSIBLE_CHARACTER_NUMERIC
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table dfkkopk {

  key mandt            : mandt not null;
  key opbel            : opbel_kk not null;
  key opupk            : opupk_kk not null;
  bukrs                : bukrs;
  hkont                : hkont_kk;
  gsber                : gsber;
  @AbapCatalog.foreignKey.screenCheck : false
  bupla                : bupla
    with foreign key j_1bbranch
      where mandt = dfkkopk.mandt
        and bukrs = dfkkopk.bukrs
        and branch = dfkkopk.bupla;
  segment              : segmt_kk;
  prctr                : prctr;
  kostl                : kostl;
  kdauf                : kdauf;
  kdpos                : kdpos;
  kdein                : kdein;
  ps_psp_pnr           : ps_psp_pnr;
  paobjnr              : rkeobjnr;
  pasubnr              : rkesubnr;
  fdlev                : fdlev_kk;
  valut                : valut;
  kursf                : kursf_kk;
  @Semantics.amount.currencyCode : 't001.waers'
  betrh                : betrh_kk;
  @Semantics.amount.currencyCode : 'dfkkko.waers'
  betrw                : betrw_kk;
  @Semantics.amount.currencyCode : 'x001.hwae2'
  betr2                : betr2_kk;
  @Semantics.amount.currencyCode : 'x001.hwae3'
  betr3                : betr3_kk;
  whgrp                : whgrp_kk;
  strkz                : strkz_kk;
  qssew                : qssew_kk;
  txgrp                : txgrp_kk;
  mwskz                : mwskz;
  mwszkz               : mwszkz_kk;
  txjcd                : txjcd;
  txjco                : txjco_kk;
  txcnt                : txcnt_kk;
  txdat                : txdat_kk;
  txexk                : txexk_kk;
  @Semantics.amount.currencyCode : 't001.waers'
  sbash                : sbash_kk;
  @Semantics.amount.currencyCode : 'dfkkko.waers'
  sbasw                : sbasw_kk;
  @Semantics.amount.currencyCode : 'dfkkko.waers'
  ndtax                : ndtax_kk;
  @Semantics.amount.currencyCode : 't001.waers'
  ndtxh                : ndtxh_kk;
  xndtx                : xndtx_kk;
  ktosl                : ktosl_kk;
  stprz                : stprz_kk;
  kschl                : kschl;
  aufnr                : aufnr;
  xeiph                : xeiph_kk;
  vbund                : rassc;
  kontt                : kontt_kk;
  kontl                : kontl_kk;
  xintb                : xintb_kk;
  eurou                : eurou_kk;
  fikey                : fikey_kk;
  xcopa                : xcopa_kk;
  @Semantics.quantity.unitOfMeasure : 'dfkkopk.meins'
  menge                : menge_d;
  @AbapCatalog.foreignKey.screenCheck : false
  meins                : meins
    with foreign key [0..*,0..1] t006
      where mandt = dfkkopk.mandt
        and msehi = dfkkopk.meins;
  regio                : regio;
  counc                : counc;
  gricd                : j_1agicd_d;
  gityp                : j_1adtyp_d;
  intbu                : intbu_kk;
  negbu                : negbu_kk;
  pswsl                : pswsl_kk;
  psgrp                : psgrp_kk;
  invgr                : invgr_kk;
  @Semantics.amount.currencyCode : 't001.waers'
  sctax                : sctax_kk;
  @Semantics.amount.currencyCode : 'dfkkko.waers'
  sttax                : sttax_kk;
  ldgrp                : ldgrp_kk;
  aasta                : aasta_kk;
  xcsha                : xcsha_kk;
  reacc                : reacc_kk;
  rebuk                : rebuk_kk;
  xustpd               : xustpd_kk;
  xdexr                : xdexr_kk;
  include si_fkkopkr;
  include si_fkkopkv;
  include si_fkkopkt;
  include si_fkkopkp;
  include si_fkkopks;
  include si_fkkopkc_cloud;
  include ci_fkkopk;
  include si_fkkfmopk;
  include ci_fkkfmopk;
  include si_fkkefopk;
  include si_fkkopkc_ustpd_cloud;
  include ci_fkkopk_ustpd;
  @AbapCatalog.foreignKey.screenCheck : true
  hbkid                : hbkid
    with foreign key t012
      where mandt = dfkkopk.mandt
        and bukrs = dfkkopk.bukrs
        and hbkid = dfkkopk.hbkid;
  @AbapCatalog.foreignKey.screenCheck : true
  hktid                : hktid
    with foreign key t012k
      where mandt = dfkkopk.mandt
        and bukrs = dfkkopk.bukrs
        and hbkid = dfkkopk.hbkid
        and hktid = dfkkopk.hktid;
  squan                : sign_quantity;
  kukey                : kukey_kk;
  esnum                : esnum_eb;
  ltype                : fqm_linktype;
  lnkid                : fqm_linkid;
  _dataaging           : data_temperature;
  txdat_from           : fot_txdat_from;
  @AbapCatalog.foreignKey.screenCheck : true
  tax_country          : fot_tax_country
    with foreign key t005
      where mandt = dfkkopk.mandt
        and land1 = dfkkopk.tax_country;
  taxc_factor          : taxc_factor_kk;
  txinf                : txinf_kk;
  service_doc_type     : fco_srvdoc_type;
  service_doc_id       : fco_srvdoc_id;
  service_doc_item_id  : fco_srvdoc_item_id;
  service_doc_trans_gl : service_doc_trans_gl;
  include fkkopk_incl_eew_ps;

}