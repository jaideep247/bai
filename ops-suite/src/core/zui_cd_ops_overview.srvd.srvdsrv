@EndUserText.label: 'Production support overview page'
@ObjectModel.leadingEntity.name: 'ZC_CD_OPSCRITEXC'
// Binding to create in ADT: ZUI_CD_OPS_OVERVIEW_O4 (OData V4 - UI), the single data source of
// the Fiori elements overview page (docs/Dashboard_Production_Support.md). It re-exposes the KPI
// and latest-problem projections of the four area dashboards (same CDS objects, same DCL) and
// adds the cross-area cards. Read-only: no behaviour definition.
// 2026-11-10: control center cards - business date as global filter field (BusinessDate; default: the
// current business date, IsCurrentDay = X, today in CONTROL_TIME_ZONE); the sign-off is the framework's
// review app ZUI_CA_OPS_REV.
// 2026-11-10: business processes of the framework's check registry (process onboarding) - KPI card "Business
// processes" and list card "Process checks - attention" on the framework's area dashboard projection (same CDS,
// same DCL ZC_CA_OPSCHECKSTATUS; card annotations in its metadata extension); opens app ZUI_CA_OPS_DASH.
// 2026-11-11: service health per business service (score, worst contributors) and the process flow of the payment
// lifecycle (stuck per stage, drop) - build B block at the end.
// 2026-11-11: SAP job failures of the framework's SAP job monitor (area CD_JOBS) - KPI card "Job failures today" and
// list card on the framework's board projection ZC_CA_OpsJobFailure (DCL ZC_CA_OPSJOBFAILURE, card annotations in its
// metadata extension); opens app ZUI_CA_OPS_JOBS.
define service ZUI_CD_OPS_OVERVIEW {
  // Cross-area cards
  expose ZC_CD_OpsCritExc   as CriticalException;
  expose ZC_CD_OpsFreshness as MonitorFreshness;
  // File monitoring card
  expose ZC_CD_FmonFlowKpi  as FileFlowKpi;
  expose ZC_CD_FmonFlowFail as FileFailure;
  // EBS validation card
  expose ZC_CD_EbsKpi       as EbsKpi;
  expose ZC_CD_EbsProblem   as EbsProblem;
  // Health check card
  expose ZC_CD_HckKpi       as HealthKpi;
  expose ZC_CD_HckRed       as HealthRedCheck;
  // Transactions card
  expose ZC_CD_TrxKpi       as TransactionKpi;
  expose ZC_CD_TrxProblem   as TransactionProblem;
  // Control center (2026-11-10): daily controls (checks reviewed, controls flagged, daily health checks,
  // attention queue), payment lifecycle and its payments, open reconciliation variances
  expose ZC_CD_OpsCtlDay     as ControlDay;
  expose ZI_CA_OpsCtlStatusT as ControlStatusText;
  expose ZC_CD_PayLifecycle  as PaymentLifecycle;
  expose ZC_CD_PayOfDay      as PaymentOfDay;
  expose ZC_CD_OpsVariance   as ReconVariance;
  // Business processes (process onboarding, 2026-11-10): registered checks, flagged, stale, needs attention
  expose ZC_CA_OpsCheckStatus as ProcessCheck;
  // >>> 2026-11-11 service health and process flow (build B) - keep this block together at merge
  // Service health score per business service (ZCD_OPS_SVC / ZCD_OPS_SVCMAP) and its worst contributors;
  // process flow of the payment lifecycle (stuck per stage, drop from the previous stage)
  expose ZC_CD_SvcHealth  as ServiceHealth;
  expose ZC_CD_SvcContrib as ServiceContributor;
  expose ZC_CD_PayFlow    as PaymentFlow;
  // <<< 2026-11-11 service health and process flow (build B)
  // SAP job failures (2026-11-11, area CD_JOBS): job failures today - cancelled, child failed while the parent
  // finished, not started, long-running - and the list of today's failures (framework projection, same DCL)
  expose ZC_CA_OpsJobFailure as JobFailure;
}
