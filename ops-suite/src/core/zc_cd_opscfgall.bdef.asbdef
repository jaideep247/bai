projection;
strict ( 2 );
use draft;

define behavior for ZC_CD_OpsCfgAll alias OpsCfgAll
{
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _AlertRule { create; with draft; }
  use association _AlertChannel { create; with draft; }
  use association _OpsParam { create; with draft; }
  use association _MonitorCfg { create; with draft; }
}

define behavior for ZC_CD_AlertRule alias AlertRule
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CD_AlertChannel alias AlertChannel
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CD_OpsParam alias OpsParam
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CD_MonitorCfg alias MonitorCfg
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}
