projection;
strict ( 2 );
use draft;

define behavior for ZC_CD_OpsCfgAll alias OpsCfgAll
{
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _AlertRule { create; with draft; }
  use association _AlertChannel { create; with draft; }
  use association _ApprovedTable { create; with draft; }
}

define behavior for ZC_CD_AlertRule alias AlertRule
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CD_AlertChannel alias AlertChannel
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}

define behavior for ZC_CD_ApprovedTable alias ApprovedTable
use etag
{
  use update;
  use delete;

  use association _OpsCfgAll { with draft; }
}
