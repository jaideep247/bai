// UI annotations: Transactions dashboard - KPI per day (funnel)
// Overview-page cards: analytical card on chart Funnel, KPI card on data point Returned;
// selection variant Today. VERIFY-ADT: card rendering.
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Posting date', typeNamePlural: 'Posting dates',
                  title: { type: #STANDARD, value: 'PostingDate' } }
@UI.chart: [ { qualifier: 'Funnel',
               title: 'Funnel: posted, paid, settled, returned, open',
               chartType: #COLUMN,
               dimensions: [ 'Direction' ],
               measures: [ 'ItemCount', 'PaidReachedCount', 'SettledReachedCount', 'ReturnedCount', 'OpenCount' ],
               dimensionAttributes: [ { dimension: 'Direction', role: #CATEGORY } ],
               measureAttributes: [ { measure: 'ItemCount', role: #AXIS_1 },
                                    { measure: 'PaidReachedCount', role: #AXIS_1 },
                                    { measure: 'SettledReachedCount', role: #AXIS_1 },
                                    { measure: 'ReturnedCount', role: #AXIS_1 },
                                    { measure: 'OpenCount', role: #AXIS_1 } ] },
             { qualifier: 'ByBucket',
               title: 'Transactions by flow bucket per posting date',
               chartType: #COLUMN_STACKED,
               dimensions: [ 'PostingDate' ],
               measures: [ 'PostedBucketCount', 'ClearedBucketCount', 'PaidBucketCount', 'SettledBucketCount', 'ReturnedCount', 'ReversedCount' ],
               dimensionAttributes: [ { dimension: 'PostingDate', role: #CATEGORY } ],
               measureAttributes: [ { measure: 'PostedBucketCount', role: #AXIS_1 },
                                    { measure: 'ClearedBucketCount', role: #AXIS_1 },
                                    { measure: 'PaidBucketCount', role: #AXIS_1 },
                                    { measure: 'SettledBucketCount', role: #AXIS_1 },
                                    { measure: 'ReturnedCount', role: #AXIS_1 },
                                    { measure: 'ReversedCount', role: #AXIS_1 } ] } ]
@UI.presentationVariant: [ { sortOrder: [ { by: 'PostingDate', direction: #DESC } ],
                             visualizations: [ { type: #AS_CHART, qualifier: 'Funnel' },
                                               { type: #AS_LINEITEM } ] } ]
@UI.selectionVariant: [ { qualifier: 'Today', text: 'Posted today', filter: 'IsToday EQ X' } ]
annotate entity ZC_CD_TrxKpi with
{
  @EndUserText.label: 'Posting date'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  PostingDate;
  @EndUserText.label: 'Company code'
  @UI.lineItem: [ { position: 20, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 20 } ]
  CompanyCode;
  @EndUserText.label: 'Direction'
  @UI.lineItem: [ { position: 30, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 30 } ]
  Direction;
  @UI.hidden: true
  PaymentEngineArea;
  @EndUserText.label: 'Posted today'
  IsToday;
  @EndUserText.label: 'Transactions'
  @UI.lineItem: [ { position: 40, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Transactions', title: 'Transactions' }
  ItemCount;
  @EndUserText.label: 'FIN numbers'
  @UI.lineItem: [ { position: 50, importance: #MEDIUM } ]
  FinCount;
  @EndUserText.label: 'Paid (reached)'
  @UI.lineItem: [ { position: 60, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Paid', title: 'Paid (reached)' }
  PaidReachedCount;
  @EndUserText.label: 'Settled / encashed (reached)'
  @UI.lineItem: [ { position: 70, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Settled', title: 'Settled / encashed (reached)' }
  SettledReachedCount;
  @EndUserText.label: 'Returned'
  @UI.lineItem: [ { position: 80, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Returned', title: 'Returned', criticality: 'DayCriticality' }
  ReturnedCount;
  @EndUserText.label: 'Reversed'
  @UI.lineItem: [ { position: 90, importance: #MEDIUM } ]
  ReversedCount;
  @EndUserText.label: 'Open (not cleared)'
  @UI.lineItem: [ { position: 100, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Open', title: 'Open (not cleared)' }
  OpenCount;
  @EndUserText.label: 'With NOC'
  @UI.lineItem: [ { position: 110, importance: #MEDIUM } ]
  NocItemCount;
  @EndUserText.label: 'Bucket: posted'
  @UI.lineItem: [ { position: 120, importance: #MEDIUM } ]
  PostedBucketCount;
  @EndUserText.label: 'Bucket: cleared (no payment evidence)'
  @UI.lineItem: [ { position: 130, importance: #MEDIUM } ]
  ClearedBucketCount;
  @EndUserText.label: 'Bucket: paid'
  @UI.lineItem: [ { position: 140, importance: #MEDIUM } ]
  PaidBucketCount;
  @EndUserText.label: 'Bucket: settled'
  @UI.lineItem: [ { position: 150, importance: #MEDIUM } ]
  SettledBucketCount;
  @UI.hidden: true
  DayCriticality;
}
