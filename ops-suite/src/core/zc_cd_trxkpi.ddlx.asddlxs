// UI annotations: Transactions dashboard - KPI per day of the payment worklist
// Overview-page cards: analytical card on chart Worklist, KPI card on data point Exceptions;
// selection variant Today. VERIFY-ADT: card rendering.
// 2026-11-07: measures from the canonical payment outcome (settled from bank lines removed).
// 2026-11-08: exceptions-only worklist - no cleared / returned counts (clean payments have no row).
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Worklist date', typeNamePlural: 'Worklist dates',
                  title: { type: #STANDARD, value: 'WorklistDate' } }
@UI.chart: [ { qualifier: 'Worklist',
               title: 'Open and exceptions per direction',
               chartType: #COLUMN,
               dimensions: [ 'Direction' ],
               measures: [ 'OpenCount', 'ExceptionCount', 'LateCount', 'RequestNotPaidCount' ],
               dimensionAttributes: [ { dimension: 'Direction', role: #CATEGORY } ],
               measureAttributes: [ { measure: 'OpenCount', role: #AXIS_1 },
                                    { measure: 'ExceptionCount', role: #AXIS_1 },
                                    { measure: 'LateCount', role: #AXIS_1 },
                                    { measure: 'RequestNotPaidCount', role: #AXIS_1 } ] },
             { qualifier: 'ByDay',
               title: 'Worklist per worklist date',
               chartType: #COLUMN_STACKED,
               dimensions: [ 'WorklistDate' ],
               measures: [ 'InFlightCount', 'LateCount', 'ProblemCount', 'RequestOpenCount', 'RequestNotPaidCount' ],
               dimensionAttributes: [ { dimension: 'WorklistDate', role: #CATEGORY } ],
               measureAttributes: [ { measure: 'InFlightCount', role: #AXIS_1 },
                                    { measure: 'LateCount', role: #AXIS_1 },
                                    { measure: 'ProblemCount', role: #AXIS_1 },
                                    { measure: 'RequestOpenCount', role: #AXIS_1 },
                                    { measure: 'RequestNotPaidCount', role: #AXIS_1 } ] } ]
@UI.presentationVariant: [ { sortOrder: [ { by: 'WorklistDate', direction: #DESC } ],
                             visualizations: [ { type: #AS_CHART, qualifier: 'Worklist' },
                                               { type: #AS_LINEITEM } ] } ]
@UI.selectionVariant: [ { qualifier: 'Today', text: 'Today', filter: 'IsToday EQ X' } ]
annotate entity ZC_CD_TrxKpi with
{
  @EndUserText.label: 'Worklist date (run / due)'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]
  WorklistDate;
  @EndUserText.label: 'Company code'
  @UI.lineItem: [ { position: 20, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 20 } ]
  CompanyCode;
  @EndUserText.label: 'Direction'
  @UI.lineItem: [ { position: 30, importance: #MEDIUM } ]
  @UI.selectionField: [ { position: 30 } ]
  Direction;
  @UI.hidden: true
  PaymentEngineArea;
  @EndUserText.label: 'Today'
  IsToday;
  @EndUserText.label: 'Entries'
  @UI.lineItem: [ { position: 40, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Entries', title: 'Worklist entries' }
  EntryCount;
  @EndUserText.label: 'FIN numbers'
  @UI.lineItem: [ { position: 50, importance: #MEDIUM } ]
  FinCount;
  @EndUserText.label: 'Open'
  @UI.lineItem: [ { position: 60, importance: #MEDIUM } ]
  @UI.dataPoint: { qualifier: 'Open', title: 'Open' }
  OpenCount;
  @EndUserText.label: 'Exceptions'
  @UI.lineItem: [ { position: 70, importance: #HIGH } ]
  @UI.dataPoint: { qualifier: 'Exceptions', title: 'Exceptions', criticality: 'DayCriticality' }
  ExceptionCount;
  @EndUserText.label: 'In flight / pending'
  @UI.lineItem: [ { position: 80, importance: #MEDIUM } ]
  InFlightCount;
  @EndUserText.label: 'Late payments'
  @UI.lineItem: [ { position: 85, importance: #MEDIUM } ]
  LateCount;
  @EndUserText.label: 'Undetermined, inconsistent or ambiguous'
  @UI.lineItem: [ { position: 90, importance: #MEDIUM } ]
  ProblemCount;
  @EndUserText.label: 'Requests open (not due)'
  @UI.lineItem: [ { position: 100, importance: #LOW } ]
  RequestOpenCount;
  @EndUserText.label: 'Requests not paid on due date'
  @UI.lineItem: [ { position: 110, importance: #HIGH } ]
  @UI.dataPoint: { qualifier: 'RequestsNotPaid', title: 'Requests not paid on due date' }
  RequestNotPaidCount;
  @UI.hidden: true
  DayCriticality;
}
