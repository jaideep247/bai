// Artifact: zc_cd_opsoverview.dcls.asdcls
// Purpose: Read access to the cross-area entities of the production-support overview page
//          (service ZUI_CD_OPS_OVERVIEW): authorization object ZCD_OPS with ZCA_PARAR = the area
//          of the row (FMON, EBS, HCK, CORE) and ACTVT 03. A user sees the freshness row and the
//          critical exceptions of the areas he may display only. The area cards reuse the area
//          projections, guarded by their own roles (ZC_CD_FMONFLOW, ZC_CD_EBSDASH, ZC_CD_HCKDASH,
//          ZC_CD_TRXDASH).
// Modification log: 2026-11-06 | Initial version (production-support overview page).
//                   2026-11-10 | Control center: daily controls (area of the control), payment lifecycle and its
//                                payments (CD_OPS + company code of the base row, as ZC_CD_TRXDASH), variances
//                                (CD_HCK).
//                   2026-11-10 | Company-code isolation (ops-framework/docs/auth_zca_ops.md section 3c): critical
//                                exceptions (company code of the finding), daily controls (slice of the review per
//                                company code - the KPI cards sum only slices the user may read) and variances
//                                (company code of the reconciliation group): area authorised AND ( company code blank
//                                OR ( area, company code ) authorised ). Freshness is area-level (runs only).
//                   2026-11-11 | Service health (slice per company code, never summed), its contributors (area of the
//                                findings) and the process flow (as the payment lifecycle).
// VERIFY-ADT: aspect pfcg_auth on a projection view (7.58); BUKRS not mapped in the first condition = not checked;
//             IS INITIAL in an access condition (fallback: CompanyCode = ' ').
@EndUserText.label: 'Production support overview - read access'
@MappingRole: true
define role ZC_CD_OpsOverview {
  grant select on ZC_CD_OpsFreshness
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_OpsCritExc
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CD_OpsCtlDay
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CD_PayLifecycle
    where ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
  grant select on ZC_CD_PayOfDay
    where ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
  grant select on ZC_CD_OpsVariance
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  // >>> 2026-11-11 service health and process flow (build B) - keep this block together at merge
  // Service health: area CD_OPS, slice of the company code (blank = area-level slice); contributors: area of the
  // findings and their company code; process flow: as the payment lifecycle (CD_OPS + company code of the rows)
  grant select on ZC_CD_SvcHealth
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CD_SvcContrib
    where ( Area ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( Area, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CD_PayFlow
    where ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
  // <<< 2026-11-11 service health and process flow (build B)
}
