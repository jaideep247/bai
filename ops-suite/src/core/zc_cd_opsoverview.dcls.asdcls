// Artifact: zc_cd_opsoverview.dcls.asdcls
// Purpose: Read access to the cross-area entities of the production-support overview page
//          (service ZUI_CD_OPS_OVERVIEW): authorization object ZCD_OPS with ZCA_PARAR = the area
//          of the row (FMON, EBS, HCK, CORE) and ACTVT 03. A user sees the freshness row and the
//          critical exceptions of the areas he may display only. The area cards reuse the area
//          projections, guarded by their own roles (ZC_CD_FMONFLOW, ZC_CD_EBSDASH, ZC_CD_HCKDASH,
//          ZC_CD_TRXDASH).
// Modification log: 2026-11-06 | Initial version (production-support overview page).
//                   2026-11-10 | Control center: daily controls (area of the control), payment lifecycle and its
//                                payments (CD_OPS + company code of the base row, as ZC_CD_TRXDASH), variances
//                                (CD_HCK).
// VERIFY-ADT: aspect pfcg_auth on a projection view (7.58).
@EndUserText.label: 'Production support overview - read access'
@MappingRole: true
define role ZC_CD_OpsOverview {
  grant select on ZC_CD_OpsFreshness
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_OpsCritExc
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_OpsCtlDay
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_PayLifecycle
    where ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
  grant select on ZC_CD_PayOfDay
    where ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' );
  grant select on ZC_CD_OpsVariance
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
}
