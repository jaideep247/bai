    END OF gc_when.
ENDINTERFACE.


"! ZCA_OPS answers of this app (area of the app) for the RAP handlers
CLASS lcl_auth DEFINITION FINAL.
  PUBLIC SECTION.
    CONSTANTS gc_area TYPE zif_ca_ops_types=>ty_area VALUE 'CD_OPS'.

    "! Allowed when the user has the activity for the area (create 01, change 02, delete 06)
    CLASS-METHODS answer
      IMPORTING
        iv_actvt       TYPE zif_ca_ops_cfg_types=>ty_actvt
      RETURNING
        VALUE(rv_auth) TYPE abp_behv_auth.

    "! Editing the singleton: allowed with at least one of 01, 02 or 06 for the area
    CLASS-METHODS edit
      RETURNING
        VALUE(rv_auth) TYPE abp_behv_auth.
ENDCLASS.


CLASS lcl_auth IMPLEMENTATION.

  METHOD answer.
    rv_auth = COND #( WHEN zcl_ca_ops_cfg_factory=>get_gate( )->is_authorized( iv_area  = gc_area
                                                                               iv_actvt = iv_actvt )
                           = abap_true
                      THEN if_abap_behv=>auth-allowed
                      ELSE if_abap_behv=>auth-unauthorized ).
  ENDMETHOD.


  METHOD edit.
    rv_auth = COND #( WHEN zcl_ca_ops_cfg_factory=>get_gate( )->may_edit( gc_area ) = abap_true
                      THEN if_abap_behv=>auth-allowed
                      ELSE if_abap_behv=>auth-unauthorized ).
  ENDMETHOD.

ENDCLASS.


CLASS lhc_opscfgall DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR OpsCfgAll RESULT result.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR OpsCfgAll RESULT result.
ENDCLASS.


CLASS lhc_opscfgall IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCA_OPS for the area of the app (2026-11-08): editing the singleton needs 01, 02 or 06;
    " a new child row needs 01 - change (02) and delete (06) are answered by each child entity
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lcl_auth=>edit( ).
    ENDIF.
    IF requested_authorizations-%action-Edit = if_abap_behv=>mk-on.
      result-%action-Edit = lcl_auth=>edit( ).
    ENDIF.
    IF requested_authorizations-%assoc-_ApprovedTable = if_abap_behv=>mk-on.
      result-%assoc-_ApprovedTable = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-create ).
    ENDIF.
    IF requested_authorizations-%assoc-_PayStage = if_abap_behv=>mk-on.
      result-%assoc-_PayStage = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-create ).
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: new entries only where the client records changes (DV1)
    DATA(lv_create) = COND #( WHEN zcl_ca_ops_cfg_factory=>get_gate( )->create_allowed( ) = abap_true
                              THEN if_abap_behv=>fc-o-enabled
                              ELSE if_abap_behv=>fc-o-disabled ).
    IF requested_features-%assoc-_ApprovedTable = if_abap_behv=>mk-on.
      result-%assoc-_ApprovedTable = lv_create.
    ENDIF.
    IF requested_features-%assoc-_PayStage = if_abap_behv=>mk-on.
      result-%assoc-_PayStage = lv_create.
    ENDIF.
  ENDMETHOD.

ENDCLASS.


CLASS lhc_approvedtable DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    CONSTANTS gc_area_fields    TYPE string VALUE `FIELDS`.
    CONSTANTS gc_area_transport TYPE string VALUE `TRANSPORT`.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR ApprovedTable RESULT result.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR ApprovedTable RESULT result.

    METHODS validatefields FOR VALIDATE ON SAVE
      IMPORTING keys FOR ApprovedTable~validateFields.

    METHODS validatetransport FOR VALIDATE ON SAVE
      IMPORTING keys FOR ApprovedTable~validateTransport.
ENDCLASS.


CLASS lhc_approvedtable IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCA_OPS for the area of the app: change of a row 02, delete 06 (create 01: root)
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-change ).
    ENDIF.
    IF requested_authorizations-%delete = if_abap_behv=>mk-on.
      result-%delete = lcl_auth=>answer( zif_ca_ops_cfg_types=>gc_actvt-delete ).
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: delete only where new entries are allowed (DV1); production keeps rows
    IF requested_features-%delete = if_abap_behv=>mk-on.
      result-%delete = COND #( WHEN zcl_ca_ops_cfg_factory=>get_gate( )->delete_allowed( ) = abap_true
                               THEN if_abap_behv=>fc-o-enabled
                               ELSE if_abap_behv=>fc-o-disabled ).
    ENDIF.
  ENDMETHOD.


  METHOD validatefields.
    DATA lt_msg TYPE zif_ca_ops_cfg_types=>tt_field_message.

    READ ENTITIES OF zr_cd_opscfgall IN LOCAL MODE
      ENTITY ApprovedTable
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_rows).
    CHECK lt_rows IS NOT INITIAL.

    LOOP AT lt_rows INTO DATA(ls_row).
      CLEAR lt_msg.
      INSERT VALUE #( %tky = ls_row-%tky %state_area = gc_area_fields ) INTO TABLE reported-approvedtable.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-PaymentEngineArea )
                                        iv_list  = lif_c=>gc_val-approvedtable_paymentengineare ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-PaymentEngineArea
                        v2 = lif_c=>gc_el-paymentenginearea v3 = lif_c=>gc_val-approvedtable_paymentengineare
                        element = lif_c=>gc_el-paymentenginearea ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-PaymentEngineArea )
                                        iv_list  = lif_c=>gc_when-approvedtable_pe_area_cd_fmon ) = abap_true.
        IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Purpose )
                                          iv_list  = lif_c=>gc_val-approvedtable_purpose_cdfmon ) = abap_false.
          INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Purpose
                          v2 = lif_c=>gc_el-purpose v3 = lif_c=>gc_val-approvedtable_purpose_cdfmon
                          element = lif_c=>gc_el-purpose ) INTO TABLE lt_msg.
        ENDIF.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-PaymentEngineArea )
                                        iv_list  = lif_c=>gc_when-approvedtable_pe_area_cd_hck ) = abap_true.
        IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Purpose )
                                          iv_list  = lif_c=>gc_val-approvedtable_purpose_cdhck ) = abap_false.
          INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Purpose
                          v2 = lif_c=>gc_el-purpose v3 = lif_c=>gc_val-approvedtable_purpose_cdhck
                          element = lif_c=>gc_el-purpose ) INTO TABLE lt_msg.
        ENDIF.
        IF ls_row-FieldName IS NOT INITIAL.
          INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-must_be_blank v1 = lif_c=>gc_el-fieldname
                          v2 = lif_c=>gc_el-paymentenginearea v3 = ls_row-PaymentEngineArea
                          element = lif_c=>gc_el-fieldname ) INTO TABLE lt_msg.
        ENDIF.
      ENDIF.
      IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-PaymentEngineArea )
                                        iv_list  = lif_c=>gc_when-approvedtable_pe_area_cd_ebs ) = abap_true.
        IF zcl_ca_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Purpose )
                                          iv_list  = lif_c=>gc_val-approvedtable_purpose_cdebs ) = abap_false.
          INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Purpose
                          v2 = lif_c=>gc_el-purpose v3 = lif_c=>gc_val-approvedtable_purpose_cdebs
                          element = lif_c=>gc_el-purpose ) INTO TABLE lt_msg.
        ENDIF.
        IF ls_row-FieldName IS INITIAL.
          INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-required v1 = lif_c=>gc_el-fieldname
                          v2 = lif_c=>gc_el-paymentenginearea v3 = ls_row-PaymentEngineArea
                          element = lif_c=>gc_el-fieldname ) INTO TABLE lt_msg.
        ENDIF.
      ENDIF.
      IF ls_row-TableName IS NOT INITIAL
         AND zcl_ca_ops_cfg_checks=>table_exists( CONV #( ls_row-TableName ) ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-table_invalid v1 = ls_row-TableName
                        element = lif_c=>gc_el-tablename ) INTO TABLE lt_msg.
      ENDIF.
      IF ls_row-FieldName IS NOT INITIAL AND ls_row-TableName IS NOT INITIAL
         AND zcl_ca_ops_cfg_checks=>field_exists( iv_table = CONV #( ls_row-TableName )
                                                  iv_field = CONV #( ls_row-FieldName ) ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-field_invalid v1 = ls_row-FieldName v2 = ls_row-TableName
                        element = lif_c=>gc_el-fieldname ) INTO TABLE lt_msg.
      ENDIF.

      LOOP AT lt_msg INTO DATA(ls_msg).
        INSERT VALUE #( %tky = ls_row-%tky ) INTO TABLE failed-approvedtable.
        INSERT INITIAL LINE INTO TABLE reported-approvedtable ASSIGNING FIELD-SYMBOL(<ls_reported>).
        <ls_reported>-%tky        = ls_row-%tky.
        <ls_reported>-%state_area = gc_area_fields.
        <ls_reported>-%msg        = new_message( id       = zif_cd_ops_types=>gc_message_class
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1
                                                 v2       = ls_msg-v2
                                                 v3       = ls_msg-v3 ).
        <ls_reported>-%path-opscfgall-%is_draft   = ls_row-%is_draft.
        <ls_reported>-%path-opscfgall-SingletonID = 1.
        ASSIGN COMPONENT ls_msg-element OF STRUCTURE <ls_reported>-%element TO FIELD-SYMBOL(<lv_flag>).
        IF sy-subrc = 0.
          <lv_flag> = if_abap_behv=>mk-on.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD validatetransport.
    " DV1: every change (also a deletion) needs an open customizing request on the root
    CHECK keys IS NOT INITIAL.
    READ ENTITIES OF zr_cd_opscfgall IN LOCAL MODE
      ENTITY OpsCfgAll
        FIELDS ( TransportRequestID )
        WITH VALUE #( ( %is_draft = keys[ 1 ]-%is_draft SingletonID = 1 ) )
      RESULT DATA(lt_root).
    DATA(ls_msg) = zcl_ca_ops_cfg_factory=>get_gate( )->check_request(
                     VALUE #( lt_root[ 1 ]-TransportRequestID OPTIONAL ) ).
    LOOP AT keys INTO DATA(ls_key).
      INSERT VALUE #( %tky = ls_key-%tky %state_area = gc_area_transport ) INTO TABLE reported-approvedtable.
      IF ls_msg-number IS INITIAL.
        CONTINUE.
      ENDIF.
      INSERT VALUE #( %tky = ls_key-%tky ) INTO TABLE failed-approvedtable.
      INSERT VALUE #( %tky        = ls_key-%tky
                      %state_area = gc_area_transport
                      %msg        = new_message( id       = zif_ca_ops_types=>gc_message_class
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1 )
                      %path       = VALUE #( opscfgall-%is_draft   = ls_key-%is_draft
                                             opscfgall-SingletonID = 1 ) )
        INTO TABLE reported-approvedtable.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.


