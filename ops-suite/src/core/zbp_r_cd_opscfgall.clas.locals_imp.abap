CLASS lhc_opscfgall DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    CONSTANTS gc_pe_area TYPE zif_cd_ops_cfg_types=>ty_pe_area VALUE 'CORE'.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR OpsCfgAll RESULT result.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR OpsCfgAll RESULT result.
ENDCLASS.


CLASS lhc_opscfgall IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCD_OPS activity 02 for the payment engine area: editing the singleton covers every child
    DATA(lv_auth) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->is_authorized(
                                   iv_pe_area = gc_pe_area
                                   iv_actvt  = zif_cd_ops_cfg_types=>gc_actvt-change ) = abap_true
                            THEN if_abap_behv=>auth-allowed
                            ELSE if_abap_behv=>auth-unauthorized ).
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lv_auth.
    ENDIF.
    IF requested_authorizations-%action-Edit = if_abap_behv=>mk-on.
      result-%action-Edit = lv_auth.
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: new entries only where the client records changes (DV1)
    DATA(lv_create) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->create_allowed( ) = abap_true
                              THEN if_abap_behv=>fc-o-enabled
                              ELSE if_abap_behv=>fc-o-disabled ).
    IF requested_features-%assoc-_AlertRule = if_abap_behv=>mk-on.
      result-%assoc-_AlertRule = lv_create.
    ENDIF.
    IF requested_features-%assoc-_AlertChannel = if_abap_behv=>mk-on.
      result-%assoc-_AlertChannel = lv_create.
    ENDIF.
    IF requested_features-%assoc-_OpsParam = if_abap_behv=>mk-on.
      result-%assoc-_OpsParam = lv_create.
    ENDIF.
  ENDMETHOD.

ENDCLASS.


CLASS lhc_alertrule DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    CONSTANTS gc_area_fields    TYPE string VALUE `FIELDS`.
    CONSTANTS gc_area_transport TYPE string VALUE `TRANSPORT`.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR AlertRule RESULT result.

    METHODS validatefields FOR VALIDATE ON SAVE
      IMPORTING keys FOR AlertRule~validateFields.

    METHODS validatetransport FOR VALIDATE ON SAVE
      IMPORTING keys FOR AlertRule~validateTransport.
ENDCLASS.


CLASS lhc_alertrule IMPLEMENTATION.

  METHOD get_global_features.
    " D-3: delete only where new entries are allowed (DV1); production keeps rows
    IF requested_features-%delete = if_abap_behv=>mk-on.
      result-%delete = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->delete_allowed( ) = abap_true
                               THEN if_abap_behv=>fc-o-enabled
                               ELSE if_abap_behv=>fc-o-disabled ).
    ENDIF.
  ENDMETHOD.


  METHOD validatefields.
    DATA lt_msg TYPE zif_cd_ops_cfg_types=>tt_field_message.

    READ ENTITIES OF zr_cd_opscfgall IN LOCAL MODE
      ENTITY AlertRule
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_rows).
    CHECK lt_rows IS NOT INITIAL.

    LOOP AT lt_rows INTO DATA(ls_row).
      CLEAR lt_msg.
      APPEND VALUE #( %tky = ls_row-%tky %state_area = gc_area_fields ) TO reported-alertrule.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-PaymentEngineArea )
                                        iv_list  = `,*,EBS,FMON,HCK` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-PaymentEngineArea v2 = 'PaymentEngineArea'
                        v3 = `,*,EBS,FMON,HCK` element = 'PAYMENTENGINEAREA' ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-MinSeverity )
                                        iv_list  = `,B,E,W,I` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinSeverity v2 = 'MinSeverity'
                        v3 = `,B,E,W,I` element = 'MINSEVERITY' ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-MinRag )
                                        iv_list  = `,R,A,G` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-MinRag v2 = 'MinRag'
                        v3 = `,R,A,G` element = 'MINRAG' ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_cd_ops_cfg_checks=>window_complete( iv_from = ls_row-QuietFrom
                                                iv_to   = ls_row-QuietTo ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-window_incomplete v1 = 'QuietFrom' v2 = 'QuietTo'
                        element = 'QUIETTO' ) INTO TABLE lt_msg.
      ENDIF.

      LOOP AT lt_msg INTO DATA(ls_msg).
        APPEND VALUE #( %tky = ls_row-%tky ) TO failed-alertrule.
        APPEND INITIAL LINE TO reported-alertrule ASSIGNING FIELD-SYMBOL(<ls_reported>).
        <ls_reported>-%tky        = ls_row-%tky.
        <ls_reported>-%state_area = gc_area_fields.
        <ls_reported>-%msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1
                                                 v2       = ls_msg-v2
                                                 v3       = ls_msg-v3 ).
        <ls_reported>-%path-opscfgall-%is_draft   = ls_row-%is_draft.
        <ls_reported>-%path-opscfgall-SingletonID = 1.
        ASSIGN COMPONENT ls_msg-element OF STRUCTURE <ls_reported>-%element TO FIELD-SYMBOL(<lv_flag>).
        IF sy-subrc = 0.
          <lv_flag> = if_abap_behv=>mk-on.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD validatetransport.
    " DV1: every change (also a deletion) needs an open customizing request on the root
    CHECK keys IS NOT INITIAL.
    READ ENTITIES OF zr_cd_opscfgall IN LOCAL MODE
      ENTITY OpsCfgAll
        FIELDS ( TransportRequestID )
        WITH VALUE #( ( %is_draft = keys[ 1 ]-%is_draft SingletonID = 1 ) )
      RESULT DATA(lt_root).
    DATA(ls_msg) = zcl_cd_ops_cfg_factory=>get_gate( )->check_request(
                     VALUE #( lt_root[ 1 ]-TransportRequestID OPTIONAL ) ).
    LOOP AT keys INTO DATA(ls_key).
      APPEND VALUE #( %tky = ls_key-%tky %state_area = gc_area_transport ) TO reported-alertrule.
      IF ls_msg-number IS INITIAL.
        CONTINUE.
      ENDIF.
      APPEND VALUE #( %tky = ls_key-%tky ) TO failed-alertrule.
      APPEND VALUE #( %tky        = ls_key-%tky
                      %state_area = gc_area_transport
                      %msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1 )
                      %path       = VALUE #( opscfgall-%is_draft   = ls_key-%is_draft
                                             opscfgall-SingletonID = 1 ) )
        TO reported-alertrule.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.


