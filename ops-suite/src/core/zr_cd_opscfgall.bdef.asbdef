managed implementation in class zbp_r_cd_opscfgall unique;
strict ( 2 );
with draft;

// Approved tables and payment stages: singleton root (virtual, nothing persisted) - lock, total ETag,
// draft and the customizing request; every customizing table is a child.
define behavior for ZR_CD_OpsCfgAll alias OpsCfgAll
with unmanaged save
draft table zcd_d_opscfg
lock master
total etag LastChangedAtMax
authorization master ( global )
##DRAFT_OP_NOT_REQUIRED
{
  update;
  field ( readonly ) SingletonID, LastChangedAtMax;

  association _ApprovedTable { create ( features : global ); with draft; }
  association _PayStage { create ( features : global ); with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation ApprovedTable ~ validateFields;
    validation ApprovedTable ~ validateTransport;
    validation PayStage ~ validateFields;
    validation PayStage ~ validateTransport;
  }
}

define behavior for ZR_CD_ApprovedTable alias ApprovedTable
persistent table zcd_ops_tabwl
with additional save
draft table zcd_d_opstabwl
lock dependent by _OpsCfgAll
// ZCA_OPS per child (2026-11-08): change 02 and delete 06 here, create 01 on the root
// association. VERIFY-ADT: child entity as global authorization master with draft (7.58).
authorization master ( global )
etag master LocalLastChangedAt
{
  update;
  delete ( features : global );
  field ( readonly ) SingletonID, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly : update ) PaymentEngineArea, Purpose, TableName, FieldName;
  field ( mandatory : create ) PaymentEngineArea, Purpose, TableName;
  association _OpsCfgAll { with draft; }
  validation validateFields on save { create; update; }
  // VERIFY-ADT: delete as trigger of a validation (transport check of deletions)
  validation validateTransport on save { create; update; delete; }
  mapping for zcd_ops_tabwl
  {
    PaymentEngineArea = pe_area;
    Purpose = purpose;
    TableName = table_name;
    FieldName = field_name;
    Active = active;
    ApprovedBy = approved_by;
    Description = description;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZR_CD_PayStage alias PayStage
persistent table zcd_ops_paystage
with additional save
draft table zcd_d_paystage
lock dependent by _OpsCfgAll
// ZCA_OPS per child (2026-11-08): change 02 and delete 06 here, create 01 on the root
// association. VERIFY-ADT: child entity as global authorization master with draft (7.58).
authorization master ( global )
etag master LocalLastChangedAt
{
  update;
  delete ( features : global );
  field ( readonly ) SingletonID, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly : update ) Stage;
  field ( mandatory : create ) Stage;
  association _OpsCfgAll { with draft; }
  validation validateFields on save { create; update; }
  // VERIFY-ADT: delete as trigger of a validation (transport check of deletions)
  validation validateTransport on save { create; update; delete; }
  mapping for zcd_ops_paystage
  {
    Stage = stage;
    Seq = seq;
    Label = label;
    Source = source;
    MatchValue = match_value;
    Active = active;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
