// UI annotations: Alerting and approved tables - Approved tables per reader
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Approved table',
                     typeNamePlural: 'Approved tables per reader',
                     title: { type: #STANDARD, value: 'PaymentEngineArea' } } }
annotate entity ZC_CD_ApprovedTable with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  PaymentEngineArea;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Purpose;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  TableName;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  FieldName;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  Active;

  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  ApprovedBy;

  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 70 }]
  Description;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
