// Artifact: zc_cd_hcksuppress.dcls.asdcls
// Purpose: Read access to the suppressions app (service ZUI_CD_HCK_SUP): authorization object
//          ZCD_OPS with ZCA_PARAR HCK and ACTVT 03 (fixed values; every suppression belongs to the
//          health check). Create, end and approve keep their checks in the behaviour pool.
// Modification log: 2026-11-10 | Initial version (read authorisation of the operations apps).
// VERIFY-ADT: pfcg_auth with an empty element list and fixed field values (7.58).
@EndUserText.label: 'Health check suppressions - read access'
@MappingRole: true
define role ZC_CD_HckSuppress {
  grant select on ZC_CD_HckSuppress
    where ( ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR = 'CD_HCK', ACTVT = '03' );
}
