// UI annotations: Health check setup - Job cycles
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Job cycle',
                     typeNamePlural: 'Job cycles',
                     title: { type: #STANDARD, value: 'CycleId' } } }
annotate entity ZC_CD_JobCycle with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  CycleId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Description;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Calendar;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Active;

  @UI.hidden: true
  ChangedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
