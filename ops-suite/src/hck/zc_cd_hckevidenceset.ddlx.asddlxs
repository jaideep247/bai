// UI annotations: Health check setup - Evidence settings
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Evidence setting',
                     typeNamePlural: 'Evidence settings',
                     title: { type: #STANDARD, value: 'SetId' } } }
annotate entity ZC_CD_HckEvidenceSet with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  SetId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Name;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Value;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Description;

  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  Active;

  @UI.hidden: true
  ChangedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
