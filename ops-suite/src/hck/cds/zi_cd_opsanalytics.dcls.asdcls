// Artifact: zi_cd_opsanalytics.dcls.asdcls
// Purpose: DCL sketch - module-level read authorization for the ops dashboard
//          views (custom authorization object ZCD_OPS to be created in SU21).
// Modification log: 2026-11-05 | Initial version (ops suite consolidation).
// Authorization object ZCD_OPS (to create, class e.g. ZCD): fields ZCD_MODULE (HCK, FMON, EBS), ACTVT (03 display).
// Role for IT support: ZCD_MODULE = *, ACTVT = 03; management: same, consumed via the queries only.
// Verify on target release: aspect pfcg_auth syntax and #MAPPING role annotation.
@EndUserText.label: 'Ops suite analytics - module authorization'
@MappingRole: true
define role ZI_CD_OpsAnalytics {
  grant select on ZI_CD_OpsRun
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
  grant select on ZI_CD_OpsRunCube
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
  grant select on ZI_CD_OpsFinding
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
  grant select on ZI_CD_OpsFindingCube
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
  grant select on ZI_CD_HckMetric
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
  grant select on ZI_CD_HckMetricCube
    where ( Module ) = aspect pfcg_auth( ZCD_OPS, ZCD_MODULE, ACTVT = '03' );
}
