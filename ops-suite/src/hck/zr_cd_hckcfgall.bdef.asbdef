managed implementation in class zbp_r_cd_hckcfgall unique;
strict ( 2 );
with draft;

// Health check setup: singleton root (virtual, nothing persisted) - lock, total ETag,
// draft and the customizing request; every customizing table is a child.
define behavior for ZR_CD_HckCfgAll alias HckCfgAll
with unmanaged save
draft table zcd_d_hckcfg
lock master
total etag LastChangedAtMax
authorization master ( global )
##DRAFT_OP_NOT_REQUIRED
{
  update;
  field ( readonly ) SingletonID, LastChangedAtMax;

  association _HckCheckDef { create ( features : global ); with draft; }
  association _HckThreshold { create ( features : global ); with draft; }
  association _HckAggregate { create ( features : global ); with draft; }
  association _HckAggGroup { create ( features : global ); with draft; }
  association _JobCycle { create ( features : global ); with draft; }
  association _JobStep { create ( features : global ); with draft; }
  association _HckPmClass { create ( features : global ); with draft; }
  association _HckPmBank { create ( features : global ); with draft; }
  association _HckClrRule { create ( features : global ); with draft; }
  association _HckEvidenceSet { create ( features : global ); with draft; }
  association _HckBtcRole { create ( features : global ); with draft; }
  association _HckSeqOutcome { create ( features : global ); with draft; }
  association _HckReconSet { create ( features : global ); with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation HckCheckDef ~ validateFields;
    validation HckCheckDef ~ validateTransport;
    validation HckThreshold ~ validateFields;
    validation HckThreshold ~ validateTransport;
    validation HckAggregate ~ validateFields;
    validation HckAggregate ~ validateTransport;
    validation HckAggGroup ~ validateTransport;
    validation JobCycle ~ validateTransport;
    validation JobStep ~ validateFields;
    validation JobStep ~ validateTransport;
    validation HckPmClass ~ validateFields;
    validation HckPmClass ~ validateTransport;
    validation HckPmBank ~ validateFields;
    validation HckPmBank ~ validateTransport;
    validation HckClrRule ~ validateFields;
    validation HckClrRule ~ validateTransport;
    validation HckEvidenceSet ~ validateTransport;
    validation HckBtcRole ~ validateFields;
    validation HckBtcRole ~ validateTransport;
    validation HckSeqOutcome ~ validateFields;
    validation HckSeqOutcome ~ validateTransport;
    validation HckReconSet ~ validateFields;
    validation HckReconSet ~ validateTransport;
  }
}

