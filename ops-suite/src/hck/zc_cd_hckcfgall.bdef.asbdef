projection;
strict ( 2 );
use draft;

define behavior for ZC_CD_HckCfgAll alias HckCfgAll
{
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _HckCheckDef { create; with draft; }
  use association _HckThreshold { create; with draft; }
  use association _HckAggregate { create; with draft; }
  use association _HckDriftTable { create; with draft; }
  use association _HckWhitelist { create; with draft; }
  use association _JobCycle { create; with draft; }
  use association _JobStep { create; with draft; }
}

define behavior for ZC_CD_HckCheckDef alias HckCheckDef
use etag
{
  use update;
  use delete;

  use association _HckCfgAll { with draft; }
}

