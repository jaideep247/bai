*&---------------------------------------------------------------------*
*& Artifact: zcl_cd_hck_report_html.clas.abap
*& Purpose:
*& Pure renderer of the morning report: mobile-friendly HTML e-mail with
*& inline CSS and RAG chips, and the CSV export lines. Every value escaped.
*& Modification log:
*& 2026-11-05 | Initial version (ops suite consolidation).
*&---------------------------------------------------------------------*
"! <p class="shorttext synchronized">Health check - morning report renderer (HTML, CSV)</p>
"! No database, no SAP GUI: input is the report structure built by the
"! engine. Inline styles only (mail clients strip style blocks); single
"! column, max-width 760px, so it reads on a phone.
CLASS zcl_cd_hck_report_html DEFINITION
  PUBLIC
  FINAL
  CREATE PRIVATE.

  PUBLIC SECTION.

    CLASS-METHODS render
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS rag_chip
      IMPORTING
        iv_rag         TYPE zif_cd_ops_types=>ty_rag
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS rag_text
      IMPORTING
        iv_rag         TYPE zif_cd_ops_types=>ty_rag
      RETURNING
        VALUE(rv_text) TYPE string.

    "! Business name of a check category (A-E)
    CLASS-METHODS category_text
      IMPORTING
        iv_category    TYPE zif_cd_hck_types=>ty_category
      RETURNING
        VALUE(rv_text) TYPE string.

    CLASS-METHODS subject
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_text) TYPE string.

    CLASS-METHODS csv_header
      RETURNING
        VALUE(rv_line) TYPE string.

    "! One line per finding; a check without findings gets one line with its summary
    CLASS-METHODS render_csv
      IMPORTING
        is_report       TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rt_lines) TYPE string_table.

  PRIVATE SECTION.

    CONSTANTS:
      gc_td    TYPE string VALUE `<td style="padding:6px 8px;border-bottom:1px solid #e4e7eb;font-size:13px;">`,
      gc_th    TYPE string VALUE `<th style="padding:6px 8px;text-align:left;font-size:12px;color:#52606d;">`,
      gc_table TYPE string VALUE `<table role="presentation" width="100%" cellpadding="0" cellspacing="0">`,
      gc_h2    TYPE string VALUE `<h2 style="font-size:16px;margin:20px 0 6px 0;color:#1f2933;">`.

    CLASS-METHODS esc
      IMPORTING
        iv_text        TYPE any
      RETURNING
        VALUE(rv_text) TYPE string.

    CLASS-METHODS cell
      IMPORTING
        iv_html        TYPE string
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS header_row
      IMPORTING
        it_titles      TYPE string_table
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS section_scorecard
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS section_pe_areas
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS section_checks
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS section_exceptions
      IMPORTING
        is_report      TYPE zif_cd_hck_types=>ty_report
      RETURNING
        VALUE(rv_html) TYPE string.

    CLASS-METHODS csv_field
      IMPORTING
        iv_value        TYPE any
      RETURNING
        VALUE(rv_field) TYPE string.

ENDCLASS.



CLASS zcl_cd_hck_report_html IMPLEMENTATION.

  METHOD render.
    rv_html = `<!DOCTYPE html><html><head><meta charset="utf-8">`
           && `<meta name="viewport" content="width=device-width, initial-scale=1"></head>`
           && `<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">`
           && `<table role="presentation" width="100%" cellpadding="0" cellspacing="0" `
           && `style="max-width:760px;margin:0 auto;background:#ffffff;"><tr><td style="padding:16px;">`
           && `<h1 style="font-size:20px;margin:0 0 4px 0;">Payment engine morning report</h1>`
           && |<p style="margin:0;color:#52606d;font-size:13px;">Report date { esc( |{ is_report-report_date DATE = ISO }| ) }|
           && | &middot; generated by { esc( is_report-run-created_by ) }</p>|
           && section_scorecard( is_report )
           && section_pe_areas( is_report )
           && section_checks( is_report )
           && section_exceptions( is_report )
           && `<p style="margin:20px 0 0 0;color:#7b8794;font-size:11px;">RAG: GREEN within limits, AMBER watch / `
           && `baseline outlier, RED act now. Details: transaction SE38 ZCD_MORNING_REPORT or the operations dashboard.</p>`
           && `</td></tr></table></body></html>`.
  ENDMETHOD.


  METHOD rag_chip.
    DATA(lv_colour) = SWITCH string( iv_rag
                                     WHEN zif_cd_ops_types=>gc_rag-red   THEN `#c62828`
                                     WHEN zif_cd_ops_types=>gc_rag-amber THEN `#b26a00`
                                     WHEN zif_cd_ops_types=>gc_rag-green THEN `#2e7d32`
                                     ELSE `#6b7280` ).
    rv_html = `<span style="display:inline-block;padding:2px 10px;border-radius:12px;font-size:12px;`
           && |font-weight:bold;color:#ffffff;background:{ lv_colour };">{ rag_text( iv_rag ) }</span>|.
  ENDMETHOD.


  METHOD rag_text.
    rv_text = SWITCH #( iv_rag
                        WHEN zif_cd_ops_types=>gc_rag-red   THEN `RED`
                        WHEN zif_cd_ops_types=>gc_rag-amber THEN `AMBER`
                        WHEN zif_cd_ops_types=>gc_rag-green THEN `GREEN`
                        ELSE `N/A` ).
  ENDMETHOD.


  METHOD category_text.
    rv_text = SWITCH #( iv_category
                        WHEN zif_cd_hck_types=>gc_category-financial  THEN `Financial integrity`
                        WHEN zif_cd_hck_types=>gc_category-mass_run   THEN `Mass-run and job health`
                        WHEN zif_cd_hck_types=>gc_category-exceptions THEN `Exception queues`
                        WHEN zif_cd_hck_types=>gc_category-config     THEN `Configuration drift`
                        WHEN zif_cd_hck_types=>gc_category-technical  THEN `Technical health`
                        ELSE `Other` ).
  ENDMETHOD.


  METHOD subject.
    rv_text = |Payment engine morning report { is_report-report_date DATE = ISO }: |
           && |{ rag_text( is_report-overall_rag ) }, score { is_report-score }/100, |
           && |{ is_report-critical_count } red / { is_report-high_count } amber|.
  ENDMETHOD.


  METHOD csv_header.
    rv_line = `REPORT_DATE;CHECK_ID;CATEGORY;PRIORITY;RAG;RUNTIME_MS;SEVERITY;CHECK_CODE;OBJECT_KEY;MESSAGE`.
  ENDMETHOD.


  METHOD render_csv.
    INSERT csv_header( ) INTO TABLE rt_lines.
    LOOP AT is_report-results INTO DATA(ls_result).
      DATA(lv_prefix) = |{ csv_field( is_report-report_date ) };{ csv_field( ls_result-check_id ) };|
                     && |{ csv_field( ls_result-category ) };{ csv_field( ls_result-priority ) };|
                     && |{ csv_field( ls_result-rag ) };{ csv_field( ls_result-runtime_ms ) };|.
      IF ls_result-findings IS INITIAL.
        INSERT |{ lv_prefix }"";"";"";{ csv_field( ls_result-summary ) }| INTO TABLE rt_lines.
        CONTINUE.
      ENDIF.
      LOOP AT ls_result-findings INTO DATA(ls_finding).
        INSERT |{ lv_prefix }{ csv_field( ls_finding-severity ) };{ csv_field( ls_finding-check_code ) };|
            && |{ csv_field( ls_finding-object_key ) };{ csv_field( ls_finding-message ) }| INTO TABLE rt_lines.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD esc.
    rv_text = zcl_cd_ops_util=>html_escape( |{ iv_text }| ).
  ENDMETHOD.


  METHOD cell.
    rv_html = gc_td && iv_html && `</td>`.
  ENDMETHOD.


  METHOD header_row.
    rv_html = `<tr>`.
    LOOP AT it_titles INTO DATA(lv_title).
      rv_html = rv_html && gc_th && esc( lv_title ) && `</th>`.
    ENDLOOP.
    rv_html = rv_html && `</tr>`.
  ENDMETHOD.


  METHOD section_scorecard.
    rv_html = `<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;"><tr>`
           && `<td style="padding:12px;background:#f8f9fb;border-radius:8px;">`
           && |<span style="font-size:34px;font-weight:bold;">{ esc( is_report-score ) }</span>|
           && `<span style="font-size:14px;color:#52606d;">/100 health score</span>&nbsp;&nbsp;`
           && rag_chip( is_report-overall_rag )
           && |<div style="font-size:13px;margin-top:6px;">{ esc( is_report-critical_count ) } red (critical) &middot; |
           && |{ esc( is_report-high_count ) } amber (high)</div></td></tr></table>|
           && gc_h2 && `Categories</h2>` && gc_table
           && header_row( VALUE #( ( `Category` ) ( `Status` ) ( `Checks` ) ( `Red` ) ( `Amber` ) ) ).
    LOOP AT is_report-categories INTO DATA(ls_category).
      rv_html = rv_html && `<tr>`
             && cell( esc( |{ ls_category-category } - { category_text( ls_category-category ) }| ) )
             && cell( rag_chip( ls_category-rag ) )
             && cell( esc( ls_category-check_count ) )
             && cell( esc( ls_category-red_count ) )
             && cell( esc( ls_category-amber_count ) ) && `</tr>`.
    ENDLOOP.
    rv_html = rv_html && `</table>`.
  ENDMETHOD.


  METHOD section_pe_areas.
    IF is_report-pe_areas IS INITIAL.
      RETURN.
    ENDIF.
    rv_html = gc_h2 && `Suite payment engine areas (health of the health check)</h2>` && gc_table
           && header_row( VALUE #( ( `Payment engine area` ) ( `Last run` ) ( `Status` ) ( `Errors` ) ( `Warnings` ) ( `Age (h)` ) ) ).
    LOOP AT is_report-pe_areas INTO DATA(ls_pe_area).
      DATA(lv_age) = COND string( WHEN ls_pe_area-stale = abap_true
                                  THEN |{ esc( ls_pe_area-age_hours ) } &gt; { esc( ls_pe_area-max_age_hours ) } STALE|
                                  ELSE esc( ls_pe_area-age_hours ) ).
      rv_html = rv_html && `<tr>`
             && cell( esc( ls_pe_area-pe_area ) )
             && cell( COND #( WHEN ls_pe_area-last_run_at IS INITIAL THEN `never`
                              ELSE esc( |{ ls_pe_area-last_run_at TIMESTAMP = ISO }| ) ) )
             && cell( rag_chip( COND #( WHEN ls_pe_area-stale = abap_true THEN zif_cd_ops_types=>gc_rag-red
                                        ELSE ls_pe_area-rag ) ) )
             && cell( esc( ls_pe_area-error_count ) )
             && cell( esc( ls_pe_area-warning_count ) )
             && cell( lv_age ) && `</tr>`.
    ENDLOOP.
    rv_html = rv_html && `</table>`.
  ENDMETHOD.


  METHOD section_checks.
    rv_html = gc_h2 && `Check results</h2>` && gc_table
           && header_row( VALUE #( ( `Check` ) ( `Cat.` ) ( `Prio` ) ( `Status` ) ( `Summary` ) ) ).
    LOOP AT is_report-results INTO DATA(ls_result).
      rv_html = rv_html && `<tr>`
             && cell( |<b>{ esc( ls_result-check_id ) }</b><br>{ esc( ls_result-description ) }| )
             && cell( esc( ls_result-category ) )
             && cell( esc( ls_result-priority ) )
             && cell( rag_chip( ls_result-rag ) )
             && cell( esc( ls_result-summary ) ) && `</tr>`.
    ENDLOOP.
    IF is_report-results IS INITIAL.
      rv_html = rv_html && `<tr>` && cell( `No checks were selected or active.` ) && `</tr>`.
    ENDIF.
    rv_html = rv_html && `</table>`.
  ENDMETHOD.


  METHOD section_exceptions.
    rv_html = gc_h2 && `Oldest open exceptions</h2>`.
    IF is_report-exceptions IS INITIAL.
      rv_html = rv_html && `<p style="font-size:13px;margin:0;">No open exceptions.</p>`.
      RETURN.
    ENDIF.
    rv_html = rv_html && gc_table
           && header_row( VALUE #( ( `Payment engine area` ) ( `Code` ) ( `Object` ) ( `Message` ) ( `Owner` ) ( `Due` ) ( `Age (d)` ) ) ).
    LOOP AT is_report-exceptions INTO DATA(ls_exception).
      DATA(lv_due) = esc( |{ ls_exception-due_date DATE = ISO }| ).
      IF ls_exception-overdue_days > 0.
        lv_due = |<span style="color:#c62828;font-weight:bold;">{ lv_due } (+{ esc( ls_exception-overdue_days ) })</span>|.
      ENDIF.
      rv_html = rv_html && `<tr>`
             && cell( esc( ls_exception-pe_area ) )
             && cell( esc( ls_exception-check_code ) )
             && cell( esc( ls_exception-object_key ) )
             && cell( esc( ls_exception-message ) )
             && cell( esc( ls_exception-owner ) )
             && cell( lv_due )
             && cell( esc( ls_exception-age_days ) ) && `</tr>`.
    ENDLOOP.
    rv_html = rv_html && `</table>`.
  ENDMETHOD.


  METHOD csv_field.
    DATA(lv_text) = condense( val = |{ iv_value }| del = ` ` ).
    " neutralise spreadsheet formulas (CSV injection)
    IF lv_text IS NOT INITIAL
       AND find_any_of( val = substring( val = lv_text len = 1 ) sub = `=+-@` ) = 0
       AND NOT matches( val = lv_text pcre = `[-+]?[0-9]+(\.[0-9]+)?` ).
      lv_text = |'{ lv_text }|.
    ENDIF.
    rv_field = |"{ replace( val = lv_text sub = `"` with = `""` occ = 0 ) }"|.
  ENDMETHOD.

ENDCLASS.
