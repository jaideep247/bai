CLASS lsc_zr_cd_hckcfgall DEFINITION INHERITING FROM cl_abap_behavior_saver.
  PROTECTED SECTION.
    METHODS save_modified REDEFINITION.
    METHODS cleanup_finalize REDEFINITION.
ENDCLASS.


CLASS lsc_zr_cd_hckcfgall IMPLEMENTATION.

  METHOD save_modified.
    " The root is virtual (singleton): nothing to persist. Children are saved by
    " the framework; here they are recorded on the customizing request where the
    " client records changes (DV1). Production: no-op (change log via table logging).
    DATA(lv_request) = VALUE zif_ca_ops_cfg_types=>ty_request( update-hckcfgall[ 1 ]-TransportRequestID OPTIONAL ).
    TRY.
        zcl_ca_ops_cfg_factory=>get_gate( )->record(
          iv_request   = lv_request
          it_relations = VALUE #(
            ( entity = lif_c=>gc_ent-hckcheckdef table = lif_c=>gc_tab-hckcheckdef )
            ( entity = lif_c=>gc_ent-hckthreshold table = lif_c=>gc_tab-hckthreshold )
            ( entity = lif_c=>gc_ent-hckaggregate table = lif_c=>gc_tab-hckaggregate )
            ( entity = lif_c=>gc_ent-jobcycle table = lif_c=>gc_tab-jobcycle )
            ( entity = lif_c=>gc_ent-jobstep table = lif_c=>gc_tab-jobstep )
            ( entity = lif_c=>gc_ent-hckclrrule table = lif_c=>gc_tab-hckclrrule )
            ( entity = lif_c=>gc_ent-hckseqoutcome table = lif_c=>gc_tab-hckseqoutcome )
            ( entity = lif_c=>gc_ent-hckreconset table = lif_c=>gc_tab-hckreconset ) )
          ir_create    = REF #( create )
          ir_update    = REF #( update )
          ir_delete    = REF #( delete ) ).
      CATCH zcx_cd_ops_error INTO DATA(lx_error).
        " A recording client must never keep changes that are not on the request
        RAISE SHORTDUMP lx_error.
    ENDTRY.
  ENDMETHOD.


  METHOD cleanup_finalize.
  ENDMETHOD.

ENDCLASS.
