CLASS lhc_hckcfgall IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCD_OPS activity 02 for the payment engine area: editing the singleton covers every child
    DATA(lv_auth) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->is_authorized(
                                   iv_pe_area = gc_pe_area
                                   iv_actvt  = zif_cd_ops_cfg_types=>gc_actvt-change ) = abap_true
                            THEN if_abap_behv=>auth-allowed
                            ELSE if_abap_behv=>auth-unauthorized ).
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lv_auth.
    ENDIF.
    IF requested_authorizations-%action-Edit = if_abap_behv=>mk-on.
      result-%action-Edit = lv_auth.
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: new entries only where the client records changes (DV1)
    DATA(lv_create) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->create_allowed( ) = abap_true
                              THEN if_abap_behv=>fc-o-enabled
                              ELSE if_abap_behv=>fc-o-disabled ).
    IF requested_features-%assoc-_HckCheckDef = if_abap_behv=>mk-on.
      result-%assoc-_HckCheckDef = lv_create.
    ENDIF.
    IF requested_features-%assoc-_HckThreshold = if_abap_behv=>mk-on.
      result-%assoc-_HckThreshold = lv_create.
    ENDIF.
    IF requested_features-%assoc-_HckAggregate = if_abap_behv=>mk-on.
      result-%assoc-_HckAggregate = lv_create.
    ENDIF.
    IF requested_features-%assoc-_HckDriftTable = if_abap_behv=>mk-on.
      result-%assoc-_HckDriftTable = lv_create.
    ENDIF.
    IF requested_features-%assoc-_HckWhitelist = if_abap_behv=>mk-on.
      result-%assoc-_HckWhitelist = lv_create.
    ENDIF.
    IF requested_features-%assoc-_JobCycle = if_abap_behv=>mk-on.
      result-%assoc-_JobCycle = lv_create.
    ENDIF.
    IF requested_features-%assoc-_JobStep = if_abap_behv=>mk-on.
      result-%assoc-_JobStep = lv_create.
    ENDIF.
  ENDMETHOD.

