CLASS lhc_hckcheckdef IMPLEMENTATION.

  METHOD get_global_features.
    " D-3: delete only where new entries are allowed (DV1); production keeps rows
    IF requested_features-%delete = if_abap_behv=>mk-on.
      result-%delete = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->delete_allowed( ) = abap_true
                               THEN if_abap_behv=>fc-o-enabled
                               ELSE if_abap_behv=>fc-o-disabled ).
    ENDIF.
  ENDMETHOD.


  METHOD validatefields.
    DATA lt_msg TYPE zif_cd_ops_cfg_types=>tt_field_message.

    READ ENTITIES OF zr_cd_hckcfgall IN LOCAL MODE
      ENTITY HckCheckDef
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_rows).
    CHECK lt_rows IS NOT INITIAL.

    LOOP AT lt_rows INTO DATA(ls_row).
      CLEAR lt_msg.
      APPEND VALUE #( %tky = ls_row-%tky %state_area = gc_area_fields ) TO reported-hckcheckdef.
      IF ls_row-ClassName IS NOT INITIAL
         AND zcl_cd_ops_cfg_checks=>implements( iv_class     = CONV #( ls_row-ClassName )
                                                iv_interface = 'ZIF_CD_HCK_CHECK' ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-class_invalid v1 = ls_row-ClassName v2 = 'ZIF_CD_HCK_CHECK'
                        element = 'CLASSNAME' ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Category )
                                        iv_list  = `A,B,C,D,E` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Category v2 = 'Category'
                        v3 = `A,B,C,D,E` element = 'CATEGORY' ) INTO TABLE lt_msg.
      ENDIF.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Priority )
                                        iv_list  = `H,M,L` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Priority v2 = 'Priority'
                        v3 = `H,M,L` element = 'PRIORITY' ) INTO TABLE lt_msg.
      ENDIF.

      LOOP AT lt_msg INTO DATA(ls_msg).
        APPEND VALUE #( %tky = ls_row-%tky ) TO failed-hckcheckdef.
        APPEND INITIAL LINE TO reported-hckcheckdef ASSIGNING FIELD-SYMBOL(<ls_reported>).
        <ls_reported>-%tky        = ls_row-%tky.
        <ls_reported>-%state_area = gc_area_fields.
        <ls_reported>-%msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1
                                                 v2       = ls_msg-v2
                                                 v3       = ls_msg-v3 ).
        <ls_reported>-%path-hckcfgall-%is_draft   = ls_row-%is_draft.
        <ls_reported>-%path-hckcfgall-SingletonID = 1.
        ASSIGN COMPONENT ls_msg-element OF STRUCTURE <ls_reported>-%element TO FIELD-SYMBOL(<lv_flag>).
        IF sy-subrc = 0.
          <lv_flag> = if_abap_behv=>mk-on.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD validatetransport.
    " DV1: every change (also a deletion) needs an open customizing request on the root
    CHECK keys IS NOT INITIAL.
    READ ENTITIES OF zr_cd_hckcfgall IN LOCAL MODE
      ENTITY HckCfgAll
        FIELDS ( TransportRequestID )
        WITH VALUE #( ( %is_draft = keys[ 1 ]-%is_draft SingletonID = 1 ) )
      RESULT DATA(lt_root).
    DATA(ls_msg) = zcl_cd_ops_cfg_factory=>get_gate( )->check_request(
                     VALUE #( lt_root[ 1 ]-TransportRequestID OPTIONAL ) ).
    LOOP AT keys INTO DATA(ls_key).
      APPEND VALUE #( %tky = ls_key-%tky %state_area = gc_area_transport ) TO reported-hckcheckdef.
      IF ls_msg-number IS INITIAL.
        CONTINUE.
      ENDIF.
      APPEND VALUE #( %tky = ls_key-%tky ) TO failed-hckcheckdef.
      APPEND VALUE #( %tky        = ls_key-%tky
                      %state_area = gc_area_transport
                      %msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1 )
                      %path       = VALUE #( hckcfgall-%is_draft   = ls_key-%is_draft
                                             hckcfgall-SingletonID = 1 ) )
        TO reported-hckcheckdef.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.


