      label: 'Thresholds', position: 30, targetElement: '_HckThreshold' },
    { id: 'HckAggregate', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Generic aggregates', position: 40, targetElement: '_HckAggregate' },
    { id: 'HckDriftTable', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Tables under drift control', position: 50, targetElement: '_HckDriftTable' },
    { id: 'HckWhitelist', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Aggregate table whitelist', position: 60, targetElement: '_HckWhitelist' },
