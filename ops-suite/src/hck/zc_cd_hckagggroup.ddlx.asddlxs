// UI annotations: Health check setup - Expected groups
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Expected group',
                     typeNamePlural: 'Expected groups',
                     title: { type: #STANDARD, value: 'CheckId' } } }
annotate entity ZC_CD_HckAggGroup with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  CheckId;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  AggId;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  GroupValue;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Description;

  @UI.hidden: true
  ChangedBy;

  @UI.hidden: true
  ChangedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
