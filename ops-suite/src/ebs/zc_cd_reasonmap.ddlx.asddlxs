// UI annotations: EBS rules and mapping - Return / NOC reasons
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Return reason',
                     typeNamePlural: 'Return / NOC reasons',
                     title: { type: #STANDARD, value: 'Reason' } } }
annotate entity ZC_CD_ReasonMap with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Reason;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  FicaReason;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  IsNoc;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
