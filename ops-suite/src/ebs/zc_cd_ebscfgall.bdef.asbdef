projection;
strict ( 2 );
use draft;

define behavior for ZC_CD_EbsCfgAll alias EbsCfgAll
{
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _BtcMap { create; with draft; }
  use association _BtcRule { create; with draft; }
  use association _RuleDef { create; with draft; }
  use association _HouseBankAcct { create; with draft; }
  use association _FlowPattern { create; with draft; }
  use association _ReasonMap { create; with draft; }
  use association _EbsLookup { create; with draft; }
}

define behavior for ZC_CD_BtcMap alias BtcMap
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_BtcRule alias BtcRule
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_RuleDef alias RuleDef
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_HouseBankAcct alias HouseBankAcct
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_FlowPattern alias FlowPattern
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_ReasonMap alias ReasonMap
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}

define behavior for ZC_CD_EbsLookup alias EbsLookup
use etag
{
  use update;
  use delete;

  use association _EbsCfgAll { with draft; }
}
