// UI annotations: EBS rules and mapping - Flow patterns (XBLNR)
@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Flow pattern',
                     typeNamePlural: 'Flow patterns (XBLNR)',
                     title: { type: #STANDARD, value: 'Priority' } } }
annotate entity ZC_CD_FlowPattern with
{
  @UI.facet: [ { id: 'Details', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                label: 'Details', position: 10 } ]

  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Priority;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Pattern;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  FlowType;

  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  Active;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
