managed implementation in class zbp_r_cd_ebscfgall unique;
strict ( 2 );
with draft;

// EBS rules and mapping: singleton root (virtual, nothing persisted) - lock, total ETag,
// draft and the customizing request; every customizing table is a child.
define behavior for ZR_CD_EbsCfgAll alias EbsCfgAll
with unmanaged save
draft table zcd_d_ebscfg
lock master
total etag LastChangedAtMax
authorization master ( global )
##DRAFT_OP_NOT_REQUIRED
{
  update;
  field ( readonly ) SingletonID, LastChangedAtMax;

  association _BtcMap { create ( features : global ); with draft; }
  association _BtcRule { create ( features : global ); with draft; }
  association _RuleDef { create ( features : global ); with draft; }
  association _HouseBankAcct { create ( features : global ); with draft; }
  association _FlowPattern { create ( features : global ); with draft; }
  association _ReasonMap { create ( features : global ); with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation BtcMap ~ validateFields;
    validation BtcMap ~ validateTransport;
    validation BtcRule ~ validateFields;
    validation BtcRule ~ validateTransport;
    validation RuleDef ~ validateFields;
    validation RuleDef ~ validateTransport;
    validation HouseBankAcct ~ validateFields;
    validation HouseBankAcct ~ validateTransport;
    validation FlowPattern ~ validateFields;
    validation FlowPattern ~ validateTransport;
    validation ReasonMap ~ validateTransport;
  }
}

define behavior for ZR_CD_BtcMap alias BtcMap
persistent table zcd_btc_map
with additional save
draft table zcd_d_btcmap
lock dependent by _EbsCfgAll
authorization dependent by _EbsCfgAll
etag master LocalLastChangedAt
{
  update;
  delete ( features : global );
  field ( readonly ) SingletonID, ChangedBy, ChangedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly : update ) Scheme, BtcCode, BankKey, FlowType;
  field ( mandatory : create ) Scheme, BtcCode, FlowType;
  association _EbsCfgAll { with draft; }
  validation validateFields on save { create; update; }
  // VERIFY-ADT: delete as trigger of a validation (transport check of deletions)
  validation validateTransport on save { create; update; delete; }
  mapping for zcd_btc_map
  {
    Scheme = scheme;
    BtcCode = btc_code;
    BankKey = bank_key;
    FlowType = flow_type;
    Category = category;
    RuleGroup = rule_group;
    ExpCdi = exp_cdi;
    PayMethod = pay_method;
    PostingRule = posting_rule;
    RetReason = ret_reason;
    ActionCode = action;
    Active = active;
    Description = description;
    ChangedBy = changed_by;
    ChangedAt = changed_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

