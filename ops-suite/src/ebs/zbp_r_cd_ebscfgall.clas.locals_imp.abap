                                                  iv_field = CONV #( ls_row-KeyField ) ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-field_invalid v1 = ls_row-KeyField v2 = ls_row-TableName
                        element = lif_c=>gc_el-keyfield ) INTO TABLE lt_msg.
