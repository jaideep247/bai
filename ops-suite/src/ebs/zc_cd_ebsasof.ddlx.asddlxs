@UI.headerInfo: { typeName: 'Validation as of', typeNamePlural: 'Validation as of',
                  title: { type: #STANDARD, value: 'AsOfAt' } }
annotate entity ZC_CD_EbsAsOf with
{
  @UI.facet: [ { id: 'AsOf', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Validation run', position: 10 } ]
  @UI.hidden: true
  PaymentEngineArea;
  @UI.hidden: true
  RunId;
  @EndUserText.label: 'Run variant'
  @UI.identification: [ { position: 10 } ]
  RunVariant;
  @EndUserText.label: 'As of (end of last completed run, UTC)'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  AsOfAt;
  @EndUserText.label: 'Run started'
  @UI.identification: [ { position: 30 } ]
  RunStartedAt;
  @EndUserText.label: 'Run status (S, W, E, N)'
  @UI.lineItem: [ { position: 30, importance: #MEDIUM } ]
  @UI.identification: [ { position: 40 } ]
  RunStatus;
  @EndUserText.label: 'Run RAG'
  @UI.identification: [ { position: 50 } ]
  RunRag;
