managed implementation in class zbp_r_cd_fmoncfgall unique;
strict ( 2 );
with draft;

// File monitoring setup: singleton root (virtual, nothing persisted) - lock, total ETag,
// draft and the customizing request; every customizing table is a child.
define behavior for ZR_CD_FmonCfgAll alias FmonCfgAll
with unmanaged save
draft table zcd_d_fmoncfg
lock master
total etag LastChangedAtMax
authorization master ( global )
##DRAFT_OP_NOT_REQUIRED
{
  update;
  field ( readonly ) SingletonID, LastChangedAtMax;

  association _FmonIface { create ( features : global ); with draft; }
  association _FmonSla { create ( features : global ); with draft; }
  association _FmonSource { create ( features : global ); with draft; }
  association _FmonSourceMap { create ( features : global ); with draft; }
  association _FmonCheck { create ( features : global ); with draft; }
  association _FmonLotCfg { create ( features : global ); with draft; }
  association _FmonCalendar { create ( features : global ); with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation FmonIface ~ validateFields;
    validation FmonIface ~ validateTransport;
    validation FmonSla ~ validateFields;
    validation FmonSla ~ validateTransport;
    validation FmonSource ~ validateFields;
    validation FmonSource ~ validateTransport;
    validation FmonSourceMap ~ validateTransport;
    validation FmonCheck ~ validateFields;
    validation FmonCheck ~ validateTransport;
    validation FmonLotCfg ~ validateFields;
    validation FmonLotCfg ~ validateTransport;
    validation FmonCalendar ~ validateFields;
    validation FmonCalendar ~ validateTransport;
  }
}

define behavior for ZR_CD_FmonIface alias FmonIface
persistent table zcd_fmon_iface
with additional save
draft table zcd_d_fmiface
lock dependent by _FmonCfgAll
authorization dependent by _FmonCfgAll
etag master LocalLastChangedAt
{
  update;
  delete ( features : global );
  field ( readonly ) SingletonID, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( readonly : update ) IfaceId;
  field ( mandatory : create ) IfaceId;
  association _FmonCfgAll { with draft; }
  validation validateFields on save { create; update; }
  // VERIFY-ADT: delete as trigger of a validation (transport check of deletions)
  validation validateTransport on save { create; update; delete; }
  mapping for zcd_fmon_iface
  {
    IfaceId = iface_id;
    Direction = direction;
    FileType = file_type;
    SourceSys = source_sys;
    TargetSys = target_sys;
    PayMethod = pay_method;
    Lob = lob;
    BankKey = bank_key;
    NamePattern = name_pattern;
    MinBytes = min_bytes;
    MaxBytes = max_bytes;
    AckExpected = ack_expected;
    AckLevel = ack_level;
    Owner = owner;
    Active = active;
    Description = description;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

