// Artifact: zc_cd_fmonflow.dcls.asdcls
// Purpose: Read access to the file monitoring dashboard (service ZUI_CD_FMON_FLOW): authorization
//          object ZCD_OPS with ZCA_PARAR = FMON and ACTVT 03 (display), as the ops analytics
//          DCL ZI_CD_OpsAnalytics. Every entity carries PaymentEngineArea (FMON on every row).
//          Company-code isolation (2026-11-10, rule of ops-framework/docs/auth_zca_ops.md section 3c): the open
//          exceptions (ZC_CD_FmonFlowFind) carry the company code of the finding and are granted with BUKRS for
//          a filled one. Files, events, KPI and failures are area-level: a monitored file and its interface have
//          no company code (ZCD_FMON_IFACE), FMON findings are written without one, so the file counts never
//          contain a company-code finding. If a company code is ever added to the interface register, the
//          per-file counts (ZI_CD_FmonFileExc) must be sliced by it first (VERIFY item V44).
// Modification log: 2026-11-06 | Initial version (FMON file monitoring dashboard).
//                   2026-11-10 | Company-code isolation: open exceptions with BUKRS of the finding.
// VERIFY-ADT: aspect pfcg_auth on a literal-valued element of a projection view (7.58).
@EndUserText.label: 'FMON file monitoring dashboard - read access'
@MappingRole: true
define role ZC_CD_FmonFlow {
  grant select on ZC_CD_FmonFlow
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_FmonFlowEvt
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_FmonFlowFind
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' )
      and ( CompanyCode is initial
         or ( PaymentEngineArea, CompanyCode ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, BUKRS, ACTVT = '03' ) );
  grant select on ZC_CD_FmonAsOf
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_FmonFlowKpi
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
  grant select on ZC_CD_FmonFlowFail
    where ( PaymentEngineArea ) = aspect pfcg_auth( ZCA_OPS, ZCA_PARAR, ACTVT = '03' );
}
