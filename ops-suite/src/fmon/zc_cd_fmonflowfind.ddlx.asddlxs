// UI annotations: FMON file monitoring - open exceptions
@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Open exception', typeNamePlural: 'Open exceptions',
                  title: { type: #STANDARD, value: 'CheckCode' },
                  description: { type: #STANDARD, value: 'ObjectKey' } }
@UI.presentationVariant: [ { sortOrder: [ { by: 'Severity', direction: #ASC } ],
                             visualizations: [ { type: #AS_LINEITEM } ] } ]
annotate entity ZC_CD_FmonFlowFind with
{
  @UI.facet: [ { id: 'Finding', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Exception', position: 10 } ]
  @UI.hidden: true
  RunId;
  @UI.hidden: true
  FindingNo;
  @UI.hidden: true
  PaymentEngineArea;
  @UI.hidden: true
  FileIdHex;
  @EndUserText.label: 'File / expected file'
  @UI.lineItem: [ { position: 60, importance: #MEDIUM } ]
  @UI.identification: [ { position: 10 } ]
  ObjectKey;
  @EndUserText.label: 'Interface'
  @UI.lineItem: [ { position: 70, importance: #MEDIUM } ]
  @UI.identification: [ { position: 20 } ]
  @UI.selectionField: [ { position: 30 } ]
  IfaceId;
  @EndUserText.label: 'Payment method'
  @UI.identification: [ { position: 30 } ]
  PaymentMethod;
  @EndUserText.label: 'Check'
  @UI.lineItem: [ { position: 10, importance: #HIGH } ]
  @UI.identification: [ { position: 40 } ]
  @UI.selectionField: [ { position: 10 } ]
  CheckCode;
  @EndUserText.label: 'SLA class'
  @UI.lineItem: [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 50 } ]
  SlaClass;
  @EndUserText.label: 'Severity'
  @UI.lineItem: [ { position: 30, importance: #HIGH, criticality: 'SeverityCriticality' } ]
  @UI.identification: [ { position: 60, criticality: 'SeverityCriticality' } ]
  @UI.selectionField: [ { position: 20 } ]
  Severity;
  @UI.hidden: true
  SeverityCriticality;
  @EndUserText.label: 'Disposition (O open, A assigned)'
  @UI.lineItem: [ { position: 40, importance: #MEDIUM } ]
  @UI.identification: [ { position: 70 } ]
  Disposition;
  @EndUserText.label: 'Owner'
  @UI.lineItem: [ { position: 50, importance: #MEDIUM } ]
  @UI.identification: [ { position: 80 } ]
  Owner;
  @EndUserText.label: 'Due date'
  @UI.lineItem: [ { position: 80, importance: #MEDIUM } ]
  @UI.identification: [ { position: 90 } ]
  DueDate;
  @EndUserText.label: 'Message'
  @UI.lineItem: [ { position: 90, importance: #HIGH } ]
  @UI.identification: [ { position: 100 } ]
  FindingMessage;
  @EndUserText.label: 'First seen'
  @UI.identification: [ { position: 110 } ]
  FirstSeenAt;
  @EndUserText.label: 'Times raised'
  @UI.identification: [ { position: 120 } ]
  Occurrences;
  @EndUserText.label: 'Raised at'
  @UI.identification: [ { position: 130 } ]
  CreatedAt;
}
