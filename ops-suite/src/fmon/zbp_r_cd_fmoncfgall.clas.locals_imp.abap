CLASS lhc_fmoncfgall DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    CONSTANTS gc_module TYPE zif_cd_ops_cfg_types=>ty_module VALUE 'FMON'.

    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      IMPORTING REQUEST requested_authorizations FOR FmonCfgAll RESULT result.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR FmonCfgAll RESULT result.
ENDCLASS.


CLASS lhc_fmoncfgall IMPLEMENTATION.

  METHOD get_global_authorizations.
    " ZCD_OPS activity 02 for the module: editing the singleton covers every child
    DATA(lv_auth) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->is_authorized(
                                   iv_module = gc_module
                                   iv_actvt  = zif_cd_ops_cfg_types=>gc_actvt-change ) = abap_true
                            THEN if_abap_behv=>auth-allowed
                            ELSE if_abap_behv=>auth-unauthorized ).
    IF requested_authorizations-%update = if_abap_behv=>mk-on.
      result-%update = lv_auth.
    ENDIF.
    IF requested_authorizations-%action-Edit = if_abap_behv=>mk-on.
      result-%action-Edit = lv_auth.
    ENDIF.
  ENDMETHOD.


  METHOD get_global_features.
    " D-3: new entries only where the client records changes (DV1)
    DATA(lv_create) = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->create_allowed( ) = abap_true
                              THEN if_abap_behv=>fc-o-enabled
                              ELSE if_abap_behv=>fc-o-disabled ).
    IF requested_features-%assoc-_FmonIface = if_abap_behv=>mk-on.
      result-%assoc-_FmonIface = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonSla = if_abap_behv=>mk-on.
      result-%assoc-_FmonSla = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonSource = if_abap_behv=>mk-on.
      result-%assoc-_FmonSource = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonSourceMap = if_abap_behv=>mk-on.
      result-%assoc-_FmonSourceMap = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonCheck = if_abap_behv=>mk-on.
      result-%assoc-_FmonCheck = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonLotCfg = if_abap_behv=>mk-on.
      result-%assoc-_FmonLotCfg = lv_create.
    ENDIF.
    IF requested_features-%assoc-_FmonCalendar = if_abap_behv=>mk-on.
      result-%assoc-_FmonCalendar = lv_create.
    ENDIF.
  ENDMETHOD.

ENDCLASS.


CLASS lhc_fmoniface DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    CONSTANTS gc_area_fields    TYPE string VALUE `FIELDS`.
    CONSTANTS gc_area_transport TYPE string VALUE `TRANSPORT`.

    METHODS get_global_features FOR GLOBAL FEATURES
      IMPORTING REQUEST requested_features FOR FmonIface RESULT result.

    METHODS validatefields FOR VALIDATE ON SAVE
      IMPORTING keys FOR FmonIface~validateFields.

    METHODS validatetransport FOR VALIDATE ON SAVE
      IMPORTING keys FOR FmonIface~validateTransport.
ENDCLASS.


CLASS lhc_fmoniface IMPLEMENTATION.

  METHOD get_global_features.
    " D-3: delete only where new entries are allowed (DV1); production keeps rows
    IF requested_features-%delete = if_abap_behv=>mk-on.
      result-%delete = COND #( WHEN zcl_cd_ops_cfg_factory=>get_gate( )->delete_allowed( ) = abap_true
                               THEN if_abap_behv=>fc-o-enabled
                               ELSE if_abap_behv=>fc-o-disabled ).
    ENDIF.
  ENDMETHOD.


  METHOD validatefields.
    DATA lt_msg TYPE zif_cd_ops_cfg_types=>tt_field_message.

    READ ENTITIES OF zr_cd_fmoncfgall IN LOCAL MODE
      ENTITY FmonIface
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_rows).
    CHECK lt_rows IS NOT INITIAL.

    LOOP AT lt_rows INTO DATA(ls_row).
      CLEAR lt_msg.
      APPEND VALUE #( %tky = ls_row-%tky %state_area = gc_area_fields ) TO reported-fmoniface.
      IF zcl_cd_ops_cfg_checks=>in_list( iv_value = CONV #( ls_row-Direction )
                                        iv_list  = `I,O` ) = abap_false.
        INSERT VALUE #( number = zif_cd_ops_cfg_types=>gc_msg-value_invalid v1 = ls_row-Direction v2 = 'Direction'
                        v3 = `I,O` element = 'DIRECTION' ) INTO TABLE lt_msg.
      ENDIF.

      LOOP AT lt_msg INTO DATA(ls_msg).
        APPEND VALUE #( %tky = ls_row-%tky ) TO failed-fmoniface.
        APPEND INITIAL LINE TO reported-fmoniface ASSIGNING FIELD-SYMBOL(<ls_reported>).
        <ls_reported>-%tky        = ls_row-%tky.
        <ls_reported>-%state_area = gc_area_fields.
        <ls_reported>-%msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1
                                                 v2       = ls_msg-v2
                                                 v3       = ls_msg-v3 ).
        <ls_reported>-%path-fmoncfgall-%is_draft   = ls_row-%is_draft.
        <ls_reported>-%path-fmoncfgall-SingletonID = 1.
        ASSIGN COMPONENT ls_msg-element OF STRUCTURE <ls_reported>-%element TO FIELD-SYMBOL(<lv_flag>).
        IF sy-subrc = 0.
          <lv_flag> = if_abap_behv=>mk-on.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.


  METHOD validatetransport.
    " DV1: every change (also a deletion) needs an open customizing request on the root
    CHECK keys IS NOT INITIAL.
    READ ENTITIES OF zr_cd_fmoncfgall IN LOCAL MODE
      ENTITY FmonCfgAll
        FIELDS ( TransportRequestID )
        WITH VALUE #( ( %is_draft = keys[ 1 ]-%is_draft SingletonID = 1 ) )
      RESULT DATA(lt_root).
    DATA(ls_msg) = zcl_cd_ops_cfg_factory=>get_gate( )->check_request(
                     VALUE #( lt_root[ 1 ]-TransportRequestID OPTIONAL ) ).
    LOOP AT keys INTO DATA(ls_key).
      APPEND VALUE #( %tky = ls_key-%tky %state_area = gc_area_transport ) TO reported-fmoniface.
      IF ls_msg-number IS INITIAL.
        CONTINUE.
      ENDIF.
      APPEND VALUE #( %tky = ls_key-%tky ) TO failed-fmoniface.
      APPEND VALUE #( %tky        = ls_key-%tky
                      %state_area = gc_area_transport
                      %msg        = new_message( id       = 'ZCD_OPS'
                                                 number   = ls_msg-number
                                                 severity = if_abap_behv_message=>severity-error
                                                 v1       = ls_msg-v1 )
                      %path       = VALUE #( fmoncfgall-%is_draft   = ls_key-%is_draft
                                             fmoncfgall-SingletonID = 1 ) )
        TO reported-fmoniface.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.


