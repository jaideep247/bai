{
  "_comment": "Domains and data elements of the parameter framework. tools/abapgit_serialize.py writes src/<name>.doma.xml and src/<name>.dtel.xml from this file. Labels: short <= 10, medium <= 20, long <= 40, heading <= 55, text <= 60 characters.",
  "domains": [
    {"name": "ZCA_PARAM_AREA_ID", "type": "CHAR", "length": 16, "lowercase": false,
     "text": "Parameter area", "value_table": "ZCA_PARAM_AREA"},
    {"name": "ZCA_PARAM_NAME", "type": "CHAR", "length": 30, "lowercase": false,
     "text": "Parameter name"},
    {"name": "ZCA_PARAM_VALUE", "type": "CHAR", "length": 255, "lowercase": true,
     "text": "Parameter value (as maintained)"},
    {"name": "ZCA_PARAM_KIND", "type": "CHAR", "length": 1, "lowercase": false,
     "text": "Parameter kind",
     "values": [["P", "Single value"], ["S", "Select-option (list or range)"]]},
    {"name": "ZCA_PARAM_VTYPE", "type": "CHAR", "length": 5, "lowercase": false,
     "text": "Parameter value type",
     "values": [["INT", "Integer"], ["DEC", "Decimal number"], ["CHAR", "Text"],
                ["BOOL", "Flag: X = on, blank = off"], ["DATE", "Date YYYYMMDD"],
                ["TIME", "Time HHMMSS"], ["LIST", "Comma or semicolon separated list"],
                ["PCRE", "Regular expression (PCRE)"], ["DDIC", "DDIC type name"],
                ["CLASS", "ABAP class name"]]},
    {"name": "ZCA_PARAM_NUMB", "type": "NUMC", "length": 4, "lowercase": false,
     "text": "Parameter value row number"},
    {"name": "ZCA_PARAM_SIGN", "type": "CHAR", "length": 1, "lowercase": false,
     "text": "Range sign",
     "values": [["I", "Include"], ["E", "Exclude"]]},
    {"name": "ZCA_PARAM_OPTION", "type": "CHAR", "length": 2, "lowercase": false,
     "text": "Range option (no pattern options)",
     "values": [["EQ", "Equal"], ["NE", "Not equal"], ["GT", "Greater than"],
                ["GE", "Greater or equal"], ["LT", "Less than"], ["LE", "Less or equal"],
                ["BT", "Between"], ["NB", "Not between"]]},
    {"name": "ZCA_PARAM_DESCR", "type": "CHAR", "length": 60, "lowercase": true,
     "text": "Parameter framework description"},
    {"name": "ZCA_PARAM_OWNER", "type": "CHAR", "length": 30, "lowercase": true,
     "text": "Owner (team or person)"}
  ],
  "data_elements": [
    {"name": "ZCA_PARAM_AREA_ID", "domain": "ZCA_PARAM_AREA_ID", "text": "Parameter area",
     "short": "Area", "medium": "Parameter area", "long": "Parameter area", "heading": "Area"},
    {"name": "ZCA_PARAM_NAME", "domain": "ZCA_PARAM_NAME", "text": "Parameter name",
     "short": "Name", "medium": "Parameter name", "long": "Parameter name", "heading": "Parameter"},
    {"name": "ZCA_PARAM_VALUE", "domain": "ZCA_PARAM_VALUE", "text": "Parameter value",
     "short": "Value", "medium": "Parameter value", "long": "Parameter value", "heading": "Value"},
    {"name": "ZCA_PARAM_KIND", "domain": "ZCA_PARAM_KIND", "text": "Parameter kind (P single, S select-option)",
     "short": "Kind", "medium": "Parameter kind", "long": "Parameter kind", "heading": "Kind"},
    {"name": "ZCA_PARAM_VTYPE", "domain": "ZCA_PARAM_VTYPE", "text": "Parameter value type",
     "short": "Type", "medium": "Value type", "long": "Parameter value type", "heading": "Value type"},
    {"name": "ZCA_PARAM_NUMB", "domain": "ZCA_PARAM_NUMB", "text": "Parameter value row number",
     "short": "Row", "medium": "Row number", "long": "Parameter value row number", "heading": "Row"},
    {"name": "ZCA_PARAM_SIGN", "domain": "ZCA_PARAM_SIGN", "text": "Range sign (I include, E exclude)",
     "short": "Sign", "medium": "Sign", "long": "Range sign", "heading": "Sign"},
    {"name": "ZCA_PARAM_OPTION", "domain": "ZCA_PARAM_OPTION", "text": "Range option",
     "short": "Option", "medium": "Option", "long": "Range option", "heading": "Option"},
    {"name": "ZCA_PARAM_DESCR", "domain": "ZCA_PARAM_DESCR", "text": "Description",
     "short": "Descr.", "medium": "Description", "long": "Description", "heading": "Description"},
    {"name": "ZCA_PARAM_OWNER", "domain": "ZCA_PARAM_OWNER", "text": "Owner (team or person)",
     "short": "Owner", "medium": "Owner", "long": "Owner (team or person)", "heading": "Owner"},
    {"name": "ZCA_PARAM_PROD_EDIT", "domain": "XFELD", "text": "Values editable in production",
     "short": "Prod.edit", "medium": "Editable in prod.", "long": "Values editable in production",
     "heading": "Editable in production"},
    {"name": "ZCA_PARAM_ACTIVE", "domain": "XFELD", "text": "Area active (readable at runtime)",
     "short": "Active", "medium": "Active", "long": "Area active", "heading": "Active"},
    {"name": "ZCA_PARAM_MANDATORY", "domain": "XFELD", "text": "Value or default is mandatory",
     "short": "Mandatory", "medium": "Mandatory", "long": "Value or default mandatory", "heading": "Mandatory"},
    {"name": "ZCA_PARAM_DEV_OWNED", "domain": "XFELD", "text": "Value owned by development (transport only)",
     "short": "Dev.owned", "medium": "Developer-owned", "long": "Value owned by development",
     "heading": "Developer-owned"}
  ]
}
