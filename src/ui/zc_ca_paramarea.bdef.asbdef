// Behavior: Parameter areas (projection for the UI service)
projection;
strict ( 2 );
use draft;

define behavior for ZC_CA_ParamArea alias Area
use etag
{
  use create;
  use update;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Definition { create; with draft; }
}

define behavior for ZC_CA_ParamDef alias Definition
use etag
{
  use update;
  use delete;

  use association _Area { with draft; }
  use association _Value { create; with draft; }
}

define behavior for ZC_CA_ParamVal alias Value
use etag
{
  use update;
  use delete;

  use association _Area { with draft; }
  use association _Definition { with draft; }
}
