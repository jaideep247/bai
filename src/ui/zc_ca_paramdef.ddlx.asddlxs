// UI annotations: Parameter definitions (table, object page)
@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Parameter', typeNamePlural: 'Parameters',
                title: { type: #STANDARD, value: 'Name' },
                description: { type: #STANDARD, value: 'Description' } },
  presentationVariant: [{ sortOrder: [{ by: 'Name', direction: #ASC }] }]
}
annotate entity ZC_CA_ParamDef with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Definition', position: 10 },
    { id: 'Values', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Values',
      targetElement: '_Value', position: 20 },
    { id: 'Admin', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administration',
      targetQualifier: 'Admin', position: 30 } ]
  @UI.hidden: true
  Area;
  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  Name;
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  Kind;
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  ValueType;
  @UI: { identification: [{ position: 40 }] }
  MinValue;
  @UI: { identification: [{ position: 50 }] }
  MaxValue;
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 60 }] }
  DefaultValue;
  @UI: { identification: [{ position: 70 }] }
  AllowedPcre;
  @UI: { identification: [{ position: 80 }] }
  InterfaceName;
  @UI: { lineItem: [{ position: 50 }], identification: [{ position: 90 }] }
  Mandatory;
  @UI: { lineItem: [{ position: 60 }], identification: [{ position: 100 }] }
  DeveloperOwned;
  @UI: { lineItem: [{ position: 70 }], identification: [{ position: 110 }] }
  Description;
  @UI: { identification: [{ position: 120 }] }
  Owner;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 10 }] }
  CreatedBy;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 20 }] }
  CreatedAt;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 30 }] }
  LastChangedBy;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 40 }] }
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}
