// UI annotations: Parameter areas (list report, object page)
@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Parameter area', typeNamePlural: 'Parameter areas',
                title: { type: #STANDARD, value: 'Area' },
                description: { type: #STANDARD, value: 'Description' } },
  presentationVariant: [{ sortOrder: [{ by: 'Area', direction: #ASC }] }]
}
annotate entity ZC_CA_ParamArea with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'General', position: 10 },
    { id: 'Definitions', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Parameters',
      targetElement: '_Definition', position: 20 },
    { id: 'Admin', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administration',
      targetQualifier: 'Admin', position: 30 } ]
  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }], selectionField: [{ position: 10 }] }
  Area;
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  Description;
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }], selectionField: [{ position: 20 }] }
  OwnerTeam;
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  ProdEditable;
  @UI: { lineItem: [{ position: 50 }], identification: [{ position: 50 }] }
  Active;
  @UI: { identification: [{ position: 60 }] }
  TransportRequest;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 10 }] }
  CreatedBy;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 20 }] }
  CreatedAt;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 30 }] }
  LastChangedBy;
  @UI: { fieldGroup: [{ qualifier: 'Admin', position: 40 }] }
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}
