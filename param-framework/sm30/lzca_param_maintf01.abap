*&---------------------------------------------------------------------*
*& Artifact: lzca_param_maintf01.abap (include of function group ZCA_PARAM_MAINT)
*& Purpose:
*& Table maintenance events of ZCA_PARAM_AREA / _DEF / _VAL (SM30, SM34
*& view cluster ZCA_PARAM_VC, SPRO). Event 01 (before saving) applies the
*& rules of ZCL_CA_PARAM_VALIDATOR - the same rules the runtime applies on
*& every read - so an invalid row is refused at save instead of failing
*& every later read of its area. The first error stops the save.
*& Not an abapGit object: the function group is generated by the table
*& maintenance generator; create this include in it and assign the forms
*& (docs/OPERATIONS.md, section Maintenance in SM30 / SPRO).
*&   ZCA_PARAM_AREA  event 01  ZCA_AREA_BEFORE_SAVE
*&   ZCA_PARAM_DEF   event 01  ZCA_DEF_BEFORE_SAVE
*&   ZCA_PARAM_VAL   event 01  ZCA_VAL_BEFORE_SAVE
*& Modification log:
*& 2026-11-24 | Initial version (replaces the save checks of the RAP app).
*& 2026-11-24 | Context: rows checked against DIM1-4; one row per context for a single value.
*&---------------------------------------------------------------------*

*----------------------------------------------------------------------*
* Area: identifier rules
*----------------------------------------------------------------------*
FORM zca_area_before_save.
  DATA ls_area TYPE zca_param_area.
  DATA(lo_validator) = NEW zcl_ca_param_validator( ).

  LOOP AT total.
    CHECK <action> = neuer_eintrag OR <action> = aendern.
    ls_area = <vim_total_struc>.
    DATA(lt_messages) = lo_validator->check_area( CORRESPONDING #( ls_area ) ).
    IF lt_messages IS NOT INITIAL.
      PERFORM zca_abort_saving USING lt_messages[ 1 ].
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Definition: definition rules, then the stored value rows against the
* changed definition (a tightened pattern or limit must not leave rows
* that fail every read)
*----------------------------------------------------------------------*
FORM zca_def_before_save.
  DATA ls_def        TYPE zca_param_def.
  DATA ls_definition TYPE zif_ca_param_types=>ty_definition.
  DATA lt_rows       TYPE STANDARD TABLE OF zif_ca_param_types=>ty_value_row WITH EMPTY KEY.
  DATA(lo_validator) = NEW zcl_ca_param_validator( ).

  LOOP AT total.
    CHECK <action> = neuer_eintrag OR <action> = aendern.
    ls_def = <vim_total_struc>.
    ls_definition = CORRESPONDING #( ls_def ).

    DATA(lt_messages) = lo_validator->check_definition( ls_definition ).
    IF lt_messages IS NOT INITIAL.
      PERFORM zca_abort_saving USING lt_messages[ 1 ].
      RETURN.
    ENDIF.

    SELECT area, name, ctx1, ctx2, ctx3, ctx4, numb, sign, opti, low, high
      FROM zca_param_val
      WHERE area = @ls_def-area
        AND name = @ls_def-name
      ORDER BY area, name, ctx1, ctx2, ctx3, ctx4, numb
      INTO CORRESPONDING FIELDS OF TABLE @lt_rows.
    LOOP AT lt_rows INTO DATA(ls_row).
      DATA(ls_message) = lo_validator->check_row( is_definition = ls_definition
                                                  is_row        = ls_row ).
      IF ls_message-msgno IS NOT INITIAL.
        PERFORM zca_abort_saving USING ls_message.
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Value rows: row rules (context, sign / option, value) against the stored
* definition; a single value (kind P) keeps at most one row per context
*----------------------------------------------------------------------*
FORM zca_val_before_save.
  DATA ls_val        TYPE zca_param_val.
  DATA ls_other      TYPE zca_param_val.
  DATA ls_definition TYPE zif_ca_param_types=>ty_definition.
  DATA lv_rows       TYPE i.
  DATA(lo_validator) = NEW zcl_ca_param_validator( ).

  LOOP AT total.
    CHECK <action> = neuer_eintrag OR <action> = aendern.
    ls_val = <vim_total_struc>.

    CLEAR ls_definition.
    SELECT SINGLE area, name, kind, value_type, min_value, max_value, default_value,
                  allowed_pcre, interface_name, mandatory, dim1, dim2, dim3, dim4, description
      FROM zca_param_def
      WHERE area = @ls_val-area
        AND name = @ls_val-name
      INTO CORRESPONDING FIELDS OF @ls_definition.
    IF sy-subrc <> 0.
      " Definition created in the same save (view cluster): not stored yet.
      " The runtime validates the row on the first read.
      CONTINUE.
    ENDIF.

    DATA(ls_message) = lo_validator->check_row( is_definition = ls_definition
                                                is_row        = CORRESPONDING #( ls_val ) ).
    IF ls_message-msgno IS NOT INITIAL.
      PERFORM zca_abort_saving USING ls_message.
      RETURN.
    ENDIF.

    IF ls_definition-kind = zif_ca_param_types=>gc_kind-single.
      CLEAR lv_rows.
      LOOP AT total.
        CHECK <action> <> geloescht AND <action> <> neuer_geloescht AND <action> <> update_geloescht.
        ls_other = <vim_total_struc>.
        IF ls_other-area = ls_val-area AND ls_other-name = ls_val-name
           AND ls_other-ctx1 = ls_val-ctx1 AND ls_other-ctx2 = ls_val-ctx2
           AND ls_other-ctx3 = ls_val-ctx3 AND ls_other-ctx4 = ls_val-ctx4.
          lv_rows = lv_rows + 1.
        ENDIF.
      ENDLOOP.
      IF lv_rows > 1.
        PERFORM zca_abort_saving USING VALUE zif_ca_param_types=>ty_message(
                                         msgid = zif_ca_param_types=>gc_msgid
                                         msgno = zif_ca_param_types=>gc_msg-single_multiple
                                         v1    = ls_val-area
                                         v2    = ls_val-name
                                         v3    = |{ lv_rows }| ).
        RETURN.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Shows the message as an error and stops the save of the whole dialog
*----------------------------------------------------------------------*
FORM zca_abort_saving USING is_message TYPE zif_ca_param_types=>ty_message.
  MESSAGE ID is_message-msgid TYPE 'S' NUMBER is_message-msgno
          WITH is_message-v1 is_message-v2 is_message-v3 is_message-v4
          DISPLAY LIKE 'E'.
  vim_abort_saving = abap_true.
  sy-subrc = 4.
ENDFORM.
